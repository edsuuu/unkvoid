import { ScrollView } from "std-widgets.slint";
import { Icons, Skin } from "skin.slint";
import { DeviceRow, Ui } from "state.slint";
import { Avatar, Glyph, IconButton, Muted, RowItem } from "widgets.slint";

// A setinha ao lado do botão, no molde dos apps de chamada: escolher ali troca o microfone que sobe
// e a saída por onde o som da sala toca, sem sair da tela.
component DeviceArrow inherits Rectangle {
    in property <[DeviceRow]> devices;
    callback opening();
    callback chosen(int);

    width: 16px;
    height: 34px;

    Glyph {
        commands: Icons.chevron-down;
        tint: touch.has-hover ? Skin.ink-strong : Skin.ink-dim;
        size: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // A lista é lida na hora de abrir: aparelho ligado depois que o app abriu tem
            // de aparecer sem reiniciar nada.
            root.opening();
            popup.show();
        }
    }

    popup := PopupWindow {
        x: -248px;
        y: -196px;
        width: 264px;
        height: 188px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: #100d1af5;
            border-radius: 14px;
            border-width: 1px;
            border-color: Skin.line-strong;

            ScrollView {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;

                VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    if root.devices.length == 0 : Muted {
                        text: "Nenhum aparelho encontrado.";
                        font-size: 12.5px;
                    }

                    for device[index] in root.devices : RowItem {
                        on: device.current;
                        clicked => {
                            root.chosen(index);
                            popup.close();
                        }

                        HorizontalLayout {
                            padding-left: 11px;
                            padding-right: 11px;

                            Text {
                                text: device.label;
                                color: Skin.ink-body;
                                font-size: 13px;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// A barra de baixo: quem é você, o microfone e o som — cada um com a setinha do lado.
export component UserBar inherits Rectangle {
    height: 56px;
    background: #ffffff08;
    border-radius: 14px;
    border-width: 1px;
    border-color: Skin.line;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        Avatar {
            letter: Ui.user-initial;
            size: 32px;
            mine: Ui.signed-in;
            y: (parent.height - self.height) / 2;
        }

        Rectangle { width: 4px; }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: Ui.user-name == "" ? "Sem conta" : Ui.user-name;
                color: Skin.ink-strong;
                font-size: 13.5px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: Ui.signed-in ? "Conectado" : "Sala por código";
                color: Skin.ink-dim;
                font-size: 11px;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        IconButton {
            commands: Ui.mic-on ? Icons.mic : Icons.mic-off;
            on: Ui.mic-on;
            enabled: Ui.can-speak;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-mic(); }
        }

        DeviceArrow {
            devices: Ui.microphones;
            y: (parent.height - self.height) / 2;
            opening => { Ui.list-microphones(); }
            chosen(index) => { Ui.use-microphone(index); }
        }

        Rectangle { width: 4px; }

        IconButton {
            commands: Ui.deafened ? Icons.headphones-off : Icons.headphones;
            on: !Ui.deafened;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-deafen(); }
        }

        DeviceArrow {
            devices: Ui.speakers;
            y: (parent.height - self.height) / 2;
            opening => { Ui.list-speakers(); }
            chosen(index) => { Ui.use-speaker(index); }
        }
    }
}
