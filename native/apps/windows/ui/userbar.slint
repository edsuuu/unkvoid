import { ScrollView } from "std-widgets.slint";
import { Icons, Skin } from "skin.slint";
import { DeviceRow, Ui } from "state.slint";
import { Avatar, Glyph, LabelMono, Muted, RowItem } from "widgets.slint";

// Os controles da barra são chapados: sem contorno, o fundo só aparece ao passar o mouse, e
// o desenho cresce um pouco junto — é o `btn-icon` dessa barra no React e no Mac.
component BarButton inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    in property <bool> alert;
    in property <bool> open;
    callback clicked();

    // As medidas que o Mac fixou: 16,5 numa caixa de 28, e escala 1,12 sob o mouse.
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: root.open || touch.has-hover ? Skin.row : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    Glyph {
        commands: root.commands;
        size: touch.has-hover ? 18.5px : 16.5px;
        tint: root.alert ? Skin.danger : (root.open ? Skin.ink-strong : Skin.ink-icon);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        animate width, height { duration: 90ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A setinha ao lado do botão, como no Mac: ela abre a lista de aparelhos sem depender de
// estar numa voz para escolher.
component DeviceArrow inherits Rectangle {
    in property <[DeviceRow]> devices;
    in property <string> heading;
    callback opening();
    callback chosen(int);

    width: 18px;
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? Skin.row : transparent;

    Glyph {
        commands: Icons.chevron-down;
        size: touch.has-hover ? 14px : 12.5px;
        tint: touch.has-hover ? Skin.ink-strong : Skin.ink-dim;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        animate width, height { duration: 90ms; easing: ease-out; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // A lista é lida na hora de abrir: aparelho ligado depois que o app abriu tem
            // de aparecer sem reiniciar nada.
            root.opening();
            list.show();
        }
    }

    list := PopupWindow {
        x: -246px;
        y: -196px;
        width: 260px;
        height: 188px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: #100d1af5;
            border-radius: 14px;
            border-width: 1px;
            border-color: Skin.line-strong;

            ScrollView {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;

                VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    LabelMono { text: root.heading; }

                    if root.devices.length == 0 : Muted {
                        text: "Nenhum aparelho encontrado.";
                    }

                    for device[index] in root.devices : RowItem {
                        on: device.current;
                        clicked => {
                            root.chosen(index);
                            list.close();
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;

                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 5px;
                                background: device.current ? Skin.brand : #ffffff33;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: device.label;
                                color: device.current ? Skin.ink-strong : Skin.ink-icon;
                                font-family: Skin.sans;
                                font-size: 12.5px;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// O botão largo da voz: metade da linha, como o `wide` do React.
component WideIcon inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.active ? #8a7cf599 : Skin.line-strong;
    background: root.active
        ? @linear-gradient(180deg, Skin.brand 0%, Skin.brand-dark 100%)
        : (touch.has-hover ? Skin.row : #ffffff0d);

    Glyph {
        commands: root.commands;
        size: 16px;
        tint: root.active ? Skin.ink-strong : Skin.ink-icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A barra de baixo: quem é você, o microfone, o som e a engrenagem — os mesmos controles do
// `VoicePanel` do React, na ordem do Mac.
export component UserBar inherits Rectangle {
    property <bool> in-voice: Ui.voice-channel != "";

    height: sheet.preferred-height;
    background: #ffffff08;
    border-radius: 14px;
    border-width: 1px;
    border-color: Skin.line;

    sheet := VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // O bloco da voz: só existe dentro de um canal de voz, e é o que o React mostra
        // em cima da linha de quem você é.
        if root.in-voice : VerticalLayout {
            // O `animate-rise` do React: o bloco da voz aparece quando se entra no canal.
            property <bool> shown;

            spacing: 10px;
            opacity: shown ? 1.0 : 0.0;
            init => { shown = true; }

            animate opacity { duration: 220ms; easing: ease-out; }

            HorizontalLayout {
                spacing: 10px;

                // O sinal muda de cor com a latência, como no React: verde até 150 ms,
                // lilás acima disso, apagado enquanto o primeiro não voltou.
                Rectangle {
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;

                    Glyph {
                        commands: Icons.signal;
                        size: 15px;
                        tint: Ui.ping-ms < 0
                            ? Skin.ink-dim
                            : (Ui.ping-ms > 150 ? Skin.lilac : Skin.online);
                    }

                    signal-touch := TouchArea { }

                    // O balão do `title` do React: a ida e volta até o servidor de mídia.
                    Rectangle {
                        visible: signal-touch.has-hover;
                        x: 0;
                        y: -30px;
                        width: said.preferred-width + 20px;
                        height: 24px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Skin.line-strong;
                        background: #100d1afa;

                        said := Text {
                            text: Ui.ping-ms < 0
                                ? "Medindo a ida e volta até o servidor de mídia"
                                : Ui.ping + " até o servidor de mídia";
                            color: Skin.ink-icon;
                            font-family: Skin.sans;
                            font-size: 11.5px;
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Voz conectada";
                        color: Skin.online;
                        font-family: Skin.sans;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: Ui.voice-name;
                        color: Skin.ink-dim;
                        font-family: Skin.mono;
                        font-size: 10.5px;
                        overflow: elide;
                    }
                }

                BarButton {
                    commands: Icons.phone-off;
                    alert: true;
                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.leave-voice(); }
                }
            }

            HorizontalLayout {
                spacing: 6px;

                WideIcon {
                    commands: Icons.camera;
                    clicked => { Ui.toggle-camera(); }
                }

                WideIcon {
                    commands: Icons.screen;
                    active: Ui.sharing;
                    clicked => { Ui.open-share(); }
                }
            }

            Rectangle {
                height: 1px;
                background: Skin.line;
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // O rosto de quem está logado, com o anel verde enquanto se fala.
            Rectangle {
                width: 30px;
                height: 30px;
                y: (parent.height - self.height) / 2;

                Avatar {
                    letter: Ui.user-initial;
                    size: 30px;
                    mine: Ui.signed-in;
                }

                Rectangle {
                    x: -2px;
                    y: -2px;
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 2px;
                    border-color: Skin.online;
                    opacity: Ui.speaking ? 1.0 : 0.0;

                    animate opacity { duration: 120ms; easing: ease-out; }
                }
            }

            Rectangle { width: 2px; }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: Ui.user-name == "" ? "Sem conta" : Ui.user-name;
                    color: Skin.ink-strong;
                    font-family: Skin.sans;
                    font-size: 12.5px;
                    font-weight: 600;
                    overflow: elide;
                }

                // Sempre "Online": o estado do microfone já está no botão, e escrevê-lo
                // duas vezes só dava chance de as duas linhas discordarem.
                Text {
                    text: "Online";
                    color: Skin.ink-dim;
                    font-family: Skin.sans;
                    font-size: 10.5px;
                    overflow: elide;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            BarButton {
                commands: Ui.mic-on ? Icons.mic : Icons.mic-off;
                alert: !Ui.mic-on;
                y: (parent.height - self.height) / 2;
                clicked => { Ui.toggle-mic(); }
            }

            DeviceArrow {
                devices: Ui.microphones;
                heading: "MICROFONE";
                y: (parent.height - self.height) / 2;
                opening => { Ui.list-microphones(); }
                chosen(index) => { Ui.use-microphone(index); }
            }

            Rectangle { width: 2px; }

            BarButton {
                commands: Ui.deafened ? Icons.headphones-off : Icons.headphones;
                alert: Ui.deafened;
                y: (parent.height - self.height) / 2;
                clicked => { Ui.toggle-deafen(); }
            }

            DeviceArrow {
                devices: Ui.speakers;
                heading: "SAÍDA DE ÁUDIO";
                y: (parent.height - self.height) / 2;
                opening => { Ui.list-speakers(); }
                chosen(index) => { Ui.use-speaker(index); }
            }

            Rectangle { width: 2px; }

            BarButton {
                commands: Icons.gear;
                open: Ui.settings-open;
                y: (parent.height - self.height) / 2;
                clicked => { Ui.open-settings(); }
            }
        }
    }
}
