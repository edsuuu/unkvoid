import { Icons, Skin } from "skin.slint";
import { Ui } from "state.slint";
import { Avatar, Glyph } from "widgets.slint";

// Os três botões da barra são chapados: sem contorno, o fundo só aparece ao passar o mouse.
// É o `btn-icon` do React nessa barra, que é diferente do botão da sala.
component BarButton inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    in property <bool> alert;
    in property <bool> open;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: root.open || touch.has-hover ? Skin.row : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    Glyph {
        commands: root.commands;
        size: 15px;
        tint: root.alert ? Skin.danger : (root.open ? Skin.ink-strong : Skin.ink-icon);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// O botão largo da voz: ocupa metade da linha, como o `wide` do React.
component WideIcon inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.active ? #8a7cf599 : Skin.line-strong;
    background: root.active
        ? @linear-gradient(180deg, Skin.brand 0%, Skin.brand-dark 100%)
        : (touch.has-hover ? Skin.row : #ffffff0d);

    Glyph {
        commands: root.commands;
        size: 16px;
        tint: root.active ? Skin.ink-strong : Skin.ink-icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A barra de baixo: quem é você, o microfone, o som e a engrenagem — os mesmos três botões
// do `VoicePanel` do React, nessa ordem.
export component UserBar inherits Rectangle {
    // Fora de um canal de voz o microfone não está mudo, está fora: o React desenha o
    // microfone inteiro e escreve "Online". Vermelho só quando se está na voz e calado.
    property <bool> in-voice: Ui.voice-channel != "";

    height: sheet.preferred-height;
    background: #ffffff08;
    border-radius: 14px;
    border-width: 1px;
    border-color: Skin.line;

    sheet := VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // O bloco da voz: só existe dentro de um canal de voz, e é o que o React mostra
        // em cima da linha de quem você é.
        if Ui.voice-channel != "" : VerticalLayout {
            // O `animate-rise` do React: o bloco da voz aparece quando se entra no canal.
            property <bool> shown;

            spacing: 10px;
            opacity: shown ? 1.0 : 0.0;
            init => { shown = true; }

            animate opacity { duration: 220ms; easing: ease-out; }

            HorizontalLayout {
                spacing: 10px;

                // O sinal muda de cor com a latência, como no React: verde até 150 ms,
                // lilás acima disso, apagado enquanto o primeiro não voltou.
                Rectangle {
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;

                    Glyph {
                        commands: Icons.signal;
                        size: 15px;
                        tint: Ui.ping-ms < 0
                            ? Skin.ink-dim
                            : (Ui.ping-ms > 150 ? Skin.lilac : Skin.online);
                    }

                    signal-touch := TouchArea { }

                    // O balão do `title` do React: a ida e volta até o servidor de mídia.
                    Rectangle {
                        visible: signal-touch.has-hover;
                        x: 0;
                        y: -30px;
                        width: said.preferred-width + 20px;
                        height: 24px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Skin.line-strong;
                        background: #100d1afa;

                        said := Text {
                            text: Ui.ping-ms < 0
                                ? "Medindo a ida e volta até o servidor de mídia"
                                : Ui.ping + " até o servidor de mídia";
                            color: Skin.ink-icon;
                            font-family: Skin.sans;
                            font-size: 11.5px;
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Voz conectada";
                        color: Skin.online;
                        font-family: Skin.sans;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: Ui.voice-name;
                        color: Skin.ink-dim;
                        font-family: Skin.mono;
                        font-size: 10.5px;
                        overflow: elide;
                    }
                }

                BarButton {
                    commands: Icons.phone-off;
                    alert: true;
                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.leave-voice(); }
                }
            }

            HorizontalLayout {
                spacing: 6px;

                WideIcon {
                    commands: Icons.camera;
                    clicked => { Ui.toggle-camera(); }
                }

                WideIcon {
                    commands: Icons.screen;
                    active: Ui.sharing;
                    clicked => { Ui.toggle-share(); }
                }
            }

            Rectangle {
                height: 1px;
                background: Skin.line;
            }
        }

    HorizontalLayout {
        spacing: 8px;

        Avatar {
            letter: Ui.user-initial;
            size: 30px;
            mine: Ui.signed-in;
            y: (parent.height - self.height) / 2;
        }

        Rectangle { width: 2px; }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: Ui.user-name == "" ? "Sem conta" : Ui.user-name;
                color: Skin.ink-strong;
                font-family: Skin.sans;
                font-size: 12.5px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: "Online";
                color: Skin.ink-dim;
                font-family: Skin.sans;
                font-size: 10.5px;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        BarButton {
            commands: root.in-voice && !Ui.mic-on ? Icons.mic-off : Icons.mic;
            alert: root.in-voice && !Ui.mic-on;
            enabled: root.in-voice && Ui.can-speak;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-mic(); }
        }

        BarButton {
            commands: Ui.deafened ? Icons.headphones-off : Icons.headphones;
            alert: Ui.deafened;
            enabled: root.in-voice;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-deafen(); }
        }

        BarButton {
            commands: Icons.gear;
            open: Ui.settings-open;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.open-settings(); }
        }
        }
    }
}
