import { ScrollView } from "std-widgets.slint";
import { Icons, Skin } from "skin.slint";
import { DeviceRow, Ui } from "state.slint";
import { Avatar, Glyph, LabelMono, Muted, RowItem } from "widgets.slint";

// Os três botões da barra são chapados: sem contorno, o fundo só aparece ao passar o mouse.
// É o `btn-icon` do React nessa barra, que é diferente do botão da sala.
component BarButton inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    in property <bool> alert;
    in property <bool> open;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: root.open || touch.has-hover ? Skin.row : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    Glyph {
        commands: root.commands;
        size: 15px;
        tint: root.alert ? Skin.danger : (root.open ? Skin.ink-strong : Skin.ink-icon);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// O botão largo da voz: ocupa metade da linha, como o `wide` do React.
component WideIcon inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.active ? #8a7cf599 : Skin.line-strong;
    background: root.active
        ? @linear-gradient(180deg, Skin.brand 0%, Skin.brand-dark 100%)
        : (touch.has-hover ? Skin.row : #ffffff0d);

    Glyph {
        commands: root.commands;
        size: 16px;
        tint: root.active ? Skin.ink-strong : Skin.ink-icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Uma linha do menu da engrenagem: ícone à esquerda, texto à direita.
component MenuItem inherits Rectangle {
    in property <string> commands;
    in property <string> text;
    in property <bool> danger;
    callback clicked();

    height: 32px;
    border-radius: 9px;
    background: touch.has-hover ? Skin.row : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Glyph {
            commands: root.commands;
            size: 15px;
            tint: root.danger ? Skin.lilac : Skin.ink-icon;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.danger ? Skin.lilac : Skin.ink-icon;
            font-family: Skin.sans;
            font-size: 12.5px;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A barra de baixo: quem é você, o microfone, o som e a engrenagem — os mesmos três botões
// do `VoicePanel` do React, nessa ordem.
export component UserBar inherits Rectangle {
    // Os aparelhos moram dentro de "Configurações da conta", como no React: a barra não
    // ganha setinha nenhuma.
    property <bool> showing-devices;

    height: sheet.preferred-height;
    background: #ffffff08;
    border-radius: 14px;
    border-width: 1px;
    border-color: Skin.line;

    sheet := VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // O bloco da voz: só existe dentro de um canal de voz, e é o que o React mostra
        // em cima da linha de quem você é.
        if Ui.voice-channel != "" : VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;

                Glyph {
                    commands: Icons.signal;
                    size: 15px;
                    tint: Skin.online;
                    y: (parent.height - self.height) / 2;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Voz conectada";
                        color: Skin.online;
                        font-family: Skin.sans;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: Ui.voice-name;
                        color: Skin.ink-dim;
                        font-family: Skin.mono;
                        font-size: 10.5px;
                        overflow: elide;
                    }
                }

                BarButton {
                    commands: Icons.phone-off;
                    alert: true;
                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.leave-voice(); }
                }
            }

            HorizontalLayout {
                spacing: 6px;

                WideIcon {
                    commands: Icons.camera;
                    clicked => { Ui.toggle-camera(); }
                }

                WideIcon {
                    commands: Icons.screen;
                    active: Ui.sharing;
                    clicked => { Ui.toggle-share(); }
                }
            }

            Rectangle {
                height: 1px;
                background: Skin.line;
            }
        }

    HorizontalLayout {
        spacing: 8px;

        Avatar {
            letter: Ui.user-initial;
            size: 30px;
            mine: Ui.signed-in;
            y: (parent.height - self.height) / 2;
        }

        Rectangle { width: 2px; }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: Ui.user-name == "" ? "Sem conta" : Ui.user-name;
                color: Skin.ink-strong;
                font-family: Skin.sans;
                font-size: 12.5px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: Ui.deafened ? "Surdo" : (Ui.mic-on ? "Microfone aberto" : "Online");
                color: Skin.ink-dim;
                font-family: Skin.sans;
                font-size: 10.5px;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        BarButton {
            commands: Ui.mic-on ? Icons.mic : Icons.mic-off;
            alert: !Ui.mic-on;
            enabled: Ui.can-speak;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-mic(); }
        }

        BarButton {
            commands: Ui.deafened ? Icons.headphones-off : Icons.headphones;
            alert: Ui.deafened;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-deafen(); }
        }

        Rectangle {
            width: 26px;
            y: (parent.height - self.height) / 2;
            height: 26px;

            BarButton {
                commands: Icons.gear;
                clicked => {
                    // A lista é lida na hora de abrir: aparelho ligado depois que o app
                    // abriu tem de aparecer sem reiniciar nada.
                    Ui.list-microphones();
                    Ui.list-speakers();
                    menu.show();
                }
            }

            menu := PopupWindow {
                x: -198px;
                y: root.showing-devices ? -392px : -132px;
                width: 224px;
                height: root.showing-devices ? 384px : 124px;
                close-policy: PopupClosePolicy.close-on-click-outside;

                Rectangle {
                    background: #100d1af5;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Skin.line-strong;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-bottom: 8px;
                            spacing: 2px;

                            Text {
                                text: Ui.user-name == "" ? "Sem conta" : Ui.user-name;
                                color: Skin.ink-strong;
                                font-family: Skin.sans;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            LabelMono {
                                text: Ui.signed-in ? "CONTA CONECTADA" : "USANDO SEM LOGIN";
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Skin.line;
                        }

                        Rectangle { height: 4px; }

                        MenuItem {
                            commands: Icons.gear;
                            text: "Configurações da conta";
                            clicked => { root.showing-devices = !root.showing-devices; }
                        }

                        if root.showing-devices : ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                LabelMono { text: "MICROFONE"; }

                                if Ui.microphones.length == 0 : Muted {
                                    text: "Nenhum aparelho encontrado.";
                                    font-size: 12.5px;
                                }

                                for device[index] in Ui.microphones : RowItem {
                                    on: device.current;
                                    clicked => { Ui.use-microphone(index); }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;

                                        Text {
                                            text: device.label;
                                            color: Skin.ink-body;
                                            font-family: Skin.sans;
                                            font-size: 12.5px;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle { height: 4px; }

                                LabelMono { text: "SAÍDA DE ÁUDIO"; }

                                if Ui.speakers.length == 0 : Muted {
                                    text: "Nenhum aparelho encontrado.";
                                    font-size: 12.5px;
                                }

                                for device[index] in Ui.speakers : RowItem {
                                    on: device.current;
                                    clicked => { Ui.use-speaker(index); }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;

                                        Text {
                                            text: device.label;
                                            color: Skin.ink-body;
                                            font-family: Skin.sans;
                                            font-size: 12.5px;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        MenuItem {
                            commands: Icons.logout;
                            text: "Sair da conta";
                            danger: true;
                            clicked => {
                                menu.close();
                                Ui.sign-out();
                            }
                        }
                    }
                }
            }
        }
        }
    }
}
