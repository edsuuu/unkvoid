import { ScrollView } from "std-widgets.slint";
import { Icons, Skin, Theme } from "skin.slint";
import { DeviceRow, Ui } from "state.slint";
import { Avatar, FlatIcon, Glyph, Label, MenuItem, MenuSheet, Meta, StatusDot, Tip } from "widgets.slint";

// A setinha ao lado do microfone e do fone: 12 de largura, abre a lista de aparelhos — e
// vale fora da voz também, para escolher antes de entrar.
component DeviceArrow inherits Rectangle {
    in property <[DeviceRow]> devices;
    in property <string> heading;
    callback opening();
    callback chosen(int);

    width: 14px;
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;

    Glyph {
        commands: Icons.chevron-down;
        size: 12px;
        tint: touch.has-hover ? Theme.ink-strong : Theme.ink-dim;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // A lista é lida na hora de abrir: aparelho ligado depois que o app abriu tem
            // de aparecer sem reiniciar nada.
            root.opening();
            list.show();
        }
    }

    list := PopupWindow {
        x: -200px;
        y: -8px - 44px - root.devices.length * 34px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        MenuSheet {
            width: 240px;

            Label {
                text: root.heading;
                x: 8px;
                height: 24px;
                vertical-alignment: center;
            }

            if root.devices.length == 0 : Meta {
                text: "Nenhum aparelho encontrado.";
                x: 8px;
                height: 32px;
                vertical-alignment: center;
            }

            for device[index] in root.devices : MenuItem {
                text: device.label;
                checkable: true;
                checked: device.current;
                clicked => {
                    root.chosen(index);
                    list.close();
                }
            }
        }
    }
}

// O sinal de 4 barrinhas do painel de voz, que o hover explica em milissegundos.
component Signal inherits Rectangle {
    width: 16px;
    height: 16px;

    HorizontalLayout {
        spacing: 2px;
        alignment: start;

        for bar[index] in [4px, 8px, 12px, 16px] : Rectangle {
            width: 2.5px;
            height: bar;
            y: parent.height - self.height;
            border-radius: 1px;
            background: Ui.ping-bars > index
                ? (Ui.ping-bars >= 4 ? Theme.online : (Ui.ping-bars == 3 ? Theme.idle : (Ui.ping-bars == 2 ? #FB923C : Theme.danger)))
                : Theme.ink-ghost;
        }
    }

    touch := TouchArea { }

    if touch.has-hover : Tip {
        text: Ui.ping-ms < 0 ? "Medindo…" : Ui.ping;
        y: -36px;
        x: 8px - self.width / 2;
    }
}

// O painel de voz acima da barra: `surface-panel`, borda de cima em `line`, respiro 8.
component VoicePanel inherits Rectangle {
    height: sheet.preferred-height;
    background: Theme.surface-panel;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }

    sheet := VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Signal {
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: Ui.voice-state == "connected"
                            ? "Voz conectada"
                            : (Ui.voice-state == "reconnecting" ? "Reconectando…" : "Conectando…");
                        color: Ui.voice-state == "connected" ? Theme.online : Theme.idle;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 16px;

                    Meta {
                        text: Ui.voice-name + " / " + Ui.server-name;
                        width: parent.width;
                        height: parent.height;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.stage-open = true; }
                    }
                }
            }

            FlatIcon {
                commands: Icons.phone-off;
                filled: true;
                hint: "Desconectar";
                alert: true;
                y: (parent.height - self.height) / 2;
                clicked => { Ui.leave-voice(); }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // ponytail: a câmera no Windows ainda não existe (o `capture` não abre webcam
            // lá). O botão fica, desabilitado, com o porquê no balão; no Linux ele liga.
            Rectangle {
                height: 32px;
                horizontal-stretch: 1;
                border-radius: 4px;
                background: Ui.camera-on ? Theme.selected : (camera.has-hover ? Theme.selected : Theme.hover);
                opacity: Ui.camera-available ? 1 : 0.5;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    Glyph {
                        commands: Icons.camera;
                        size: 18px;
                        tint: Theme.ink-soft;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Câmera";
                        color: Theme.ink;
                        font-size: 14px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                camera := TouchArea {
                    clicked => { Ui.toggle-camera(); }
                }

                if camera.has-hover : Tip {
                    text: !Ui.camera-available ? "A câmera ainda não está ligada nesta versão" : (Ui.camera-on ? "Desligar a câmera" : "Ligar a câmera");
                    y: -36px;
                    x: (parent.width - self.width) / 2;
                }
            }

            Rectangle {
                height: 32px;
                horizontal-stretch: 1;
                border-radius: 4px;
                background: screen.has-hover ? Theme.selected : Theme.hover;
                opacity: Ui.can-share ? 1.0 : 0.5;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    Glyph {
                        commands: Icons.screen;
                        size: 18px;
                        tint: Ui.sharing ? Theme.online : Theme.ink-soft;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: Ui.sharing ? "Parar" : "Tela";
                        color: Theme.ink;
                        font-size: 14px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                screen := TouchArea {
                    enabled: Ui.can-share;
                    mouse-cursor: pointer;
                    clicked => { Ui.toggle-share(); }
                }

                if screen.has-hover && !Ui.can-share : Tip {
                    text: "Você não tem permissão para compartilhar a tela aqui";
                    y: -36px;
                    x: (parent.width - self.width) / 2;
                }
            }
        }
    }
}

// A barra de baixo: 52 de altura, `surface-panel`; avatar 32 com a bolinha, o nome em
// 14/600, "Online" em 12, e os três botões de 32 com as setinhas de aparelho.
export component UserBar inherits VerticalLayout {
    if Ui.voice-channel != "" : VoicePanel { }

    Rectangle {
        height: Theme.user-bar;
        background: Theme.surface-panel;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 2px;

            Rectangle {
                width: 32px;
                height: 32px;
                y: (parent.height - self.height) / 2;

                Avatar {
                    letter: Ui.user-initial;
                    size: 32px;
                    mine: Ui.signed-in;
                }

                Rectangle {
                    x: -2px;
                    y: -2px;
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    border-width: 2px;
                    border-color: Theme.online;
                    opacity: Ui.speaking ? 1.0 : 0.0;

                    animate opacity { duration: 120ms; easing: ease-out; }
                }

                StatusDot {
                    online: true;
                    ring: Theme.surface-panel;
                    x: 20px;
                    y: 20px;
                }
            }

            Rectangle { width: 6px; }

            VerticalLayout {
                alignment: center;
                spacing: 0px;
                horizontal-stretch: 1;

                Text {
                    text: Ui.user-name == "" ? "Sem conta" : Ui.user-name;
                    color: Theme.ink-strong;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }

                // Sempre "Online": o estado do microfone já está no botão.
                Meta { text: "Online"; }
            }

            FlatIcon {
                commands: Ui.mic-on ? Icons.mic : Icons.mic-off;
                alert: !Ui.mic-on;
                enabled: Ui.can-speak;
                hint: Ui.can-speak ? (Ui.mic-on ? "Mutar" : "Desmutar") : "Mutado pelo servidor";
                y: (parent.height - self.height) / 2;
                clicked => { Ui.toggle-mic(); }
            }

            DeviceArrow {
                devices: Ui.microphones;
                heading: "MICROFONE";
                y: (parent.height - self.height) / 2;
                opening => { Ui.list-microphones(); }
                chosen(index) => { Ui.use-microphone(index); }
            }

            FlatIcon {
                commands: Ui.deafened ? Icons.headphones-off : Icons.headphones;
                alert: Ui.deafened;
                hint: Ui.deafened ? "Voltar a ouvir" : "Ensurdecer";
                y: (parent.height - self.height) / 2;
                clicked => { Ui.toggle-deafen(); }
            }

            DeviceArrow {
                devices: Ui.speakers;
                heading: "SAÍDA DE ÁUDIO";
                y: (parent.height - self.height) / 2;
                opening => { Ui.list-speakers(); }
                chosen(index) => { Ui.use-speaker(index); }
            }

            FlatIcon {
                commands: Icons.gear;
                on: Ui.settings-open;
                hint: "Configurações de usuário";
                y: (parent.height - self.height) / 2;
                clicked => {
                    Ui.settings-tab = "account";
                    Ui.open-settings();
                }
            }
        }
    }
}
