import { ScrollView, Slider } from "std-widgets.slint";
import { Icons, Skin, Theme } from "skin.slint";
import { ActionsRow, ChannelRow, MemberRow, Ui } from "state.slint";
import { Avatar, DButton, DField, FlatIcon, Glyph, Label, LivePill, MenuItem, MenuLine, MenuSheet, Meta, StatusDot, Tip } from "widgets.slint";
import { Call, VoiceChat } from "voice.slint";
import { UserBar } from "userbar.slint";

// A tela de quem tem conta, no molde do Discord: quatro colunas coladas, separadas só pela
// cor da superfície — trilho (72) | canais (240) | centro | membros (240).
//
// Quem autoriza é o Laravel. Aqui só se esconde botão — e quando o servidor responde 403, a
// frase dele é que aparece.

// ---- o menu de uma pessoa ----
//
// O mesmo menu abre na voz (clique direito) e na lista de membros. O que aparece é o que o
// núcleo disse que eu posso (`ActionsRow`); o resto nem entra.
export component PersonMenu inherits MenuSheet {
    in property <int> user-id;
    in property <string> name;
    in property <bool> mine;
    in property <ActionsRow> actions;
    /// Na minha voz: volume e mudo local existem; "Mover para" lista as outras vozes.
    in property <bool> in-my-voice;
    in property <bool> local-muted;
    /// O canal de voz em que a pessoa está, e se dá para tirá-la de lá.
    in property <string> origin-id;
    in property <bool> can-move-from;
    property <bool> moving;
    callback done();

    width: 220px;

    if !root.mine : MenuItem {
        text: "Mensagem";
        clicked => {
            Ui.message-user(root.user-id, root.name);
            root.done();
        }
    }

    if root.in-my-voice && !root.mine : MenuLine { }

    if root.in-my-voice && !root.mine : VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        Label { text: "VOLUME DO USUÁRIO"; }

        Slider {
            minimum: 0;
            maximum: 200;
            value: 100;
            changed(level) => { Ui.set-person-volume(root.user-id, level / 100); }
        }
    }

    if root.in-my-voice && !root.mine : MenuItem {
        text: "Mutar";
        checkable: true;
        checked: root.local-muted;
        clicked => {
            Ui.mute-person(root.user-id, !root.local-muted);
            root.done();
        }
    }

    if root.actions.mute || root.actions.disconnect : MenuLine { }

    if root.actions.mute : MenuItem {
        text: "Mutar no servidor";
        checkable: true;
        checked: root.actions.server-muted;
        clicked => {
            Ui.server-mute(root.user-id, !root.actions.server-muted);
            root.done();
        }
    }

    if root.actions.disconnect && root.can-move-from && Ui.voice-channels.length > 1 : MenuItem {
        text: "Mover para";
        submenu: true;
        clicked => { root.moving = !root.moving; }
    }

    if root.moving : VerticalLayout {
        padding-left: 12px;

        for channel in Ui.voice-channels : MenuItem {
            text: channel.name;
            visible: channel.can-move-here && channel.id != root.origin-id;
            height: channel.can-move-here && channel.id != root.origin-id ? 32px : 0px;
            clicked => {
                Ui.move-voice(root.user-id, channel.index);
                root.done();
            }
        }
    }

    if root.actions.disconnect : MenuItem {
        text: "Desconectar";
        clicked => {
            Ui.disconnect-voice(root.user-id);
            root.done();
        }
    }

    if root.actions.kick || root.actions.ban : MenuLine { }

    if root.actions.kick : MenuItem {
        text: "Expulsar " + root.name;
        danger: true;
        clicked => {
            Ui.ask("kick", root.user-id);
            root.done();
        }
    }

    if root.actions.ban : MenuItem {
        text: "Banir " + root.name;
        danger: true;
        clicked => {
            Ui.ask("ban", root.user-id);
            root.done();
        }
    }
}

// ---- o trilho ----

// Um ícone do trilho: 48, redondo que vira raio 16 no hover e no ativo, a pílula branca à
// esquerda e o nome no balão.
component RailIcon inherits Rectangle {
    in property <string> initial;
    in property <string> commands;
    in property <string> hint;
    in property <bool> active;
    in property <bool> plus;
    callback clicked();

    height: 48px;
    width: Theme.rail;

    // A pílula: 8 em repouso só quando há não lida (P1), 20 no hover, 40 no ativo.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 4px;
        height: root.active ? 40px : (touch.has-hover ? 20px : 0px);
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        background: #ffffff;

        animate height { duration: 150ms; easing: ease-out; }
    }

    face := Rectangle {
        x: 12px;
        width: 48px;
        height: 48px;
        border-radius: root.active || touch.has-hover ? 16px : 24px;
        background: root.plus
            ? (touch.has-hover ? Theme.online : Theme.surface-chat)
            : (root.active || touch.has-hover ? Theme.brand : Theme.surface-chat);

        animate border-radius, background { duration: 150ms; easing: ease-out; }

        if root.commands != "" : Glyph {
            commands: root.commands;
            size: 24px;
            tint: root.plus ? (touch.has-hover ? #ffffff : Theme.online) : Theme.ink-strong;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        if root.commands == "" : Text {
            text: root.initial;
            color: Theme.ink-strong;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        x: 12px;
        width: 48px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if touch.has-hover : Tip {
        text: root.hint;
        x: Theme.rail + 4px;
        y: (parent.height - self.height) / 2;
    }
}

component Rail inherits Rectangle {
    width: Theme.rail;
    background: Theme.surface-rail;

    VerticalLayout {
        padding-top: 12px;
        spacing: 8px;
        alignment: start;

        RailIcon {
            commands: Icons.home;
            hint: Ui.room-code != "" ? "Voltar à sala " + Ui.room-code : "Mensagens diretas";
            active: !Ui.in-server;
            clicked => {
                if Ui.room-code != "" && !Ui.in-server {
                    Ui.back-to-room();
                } else {
                    Ui.show-hub-home();
                }
            }
        }

        // A sala por código no ar: o ponto verde abaixo da Home, e o clique volta a ela.
        if Ui.room-code != "" : Rectangle {
            height: 10px;

            Rectangle {
                width: 8px;
                height: 8px;
                x: (Theme.rail - self.width) / 2;
                border-radius: 4px;
                background: Theme.online;
            }
        }

        Rectangle {
            height: 2px;

            Rectangle {
                width: 32px;
                height: 2px;
                x: (Theme.rail - self.width) / 2;
                border-radius: 1px;
                background: Theme.line;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for server[index] in Ui.servers : RailIcon {
                    initial: server.initial;
                    hint: server.name;
                    active: server.current && Ui.in-server;
                    clicked => { Ui.open-server(index); }
                }

                RailIcon {
                    commands: Icons.plus;
                    hint: "Adicionar um servidor";
                    plus: true;
                    clicked => { Ui.open-modal("server-new", -1); }
                }
            }
        }
    }
}

// ---- a coluna de canais ----

component CategoryHead inherits Rectangle {
    in property <string> text;
    in property <bool> can-add;
    callback add();

    height: 24px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 8px;

        Label {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        if root.can-add : Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;

            Glyph {
                commands: Icons.plus;
                size: 16px;
                tint: plus.has-hover ? Theme.ink-strong : Theme.ink-dim;
                opacity: hover.has-hover || plus.has-hover ? 1.0 : 0.0;
            }

            plus := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.add(); }
            }

            if plus.has-hover : Tip {
                text: "Criar canal";
                y: -36px;
                x: 8px - self.width / 2;
            }
        }
    }

    hover := TouchArea { }
}

// A linha de canal: 32 de altura, margem 0 8, raio 4; ícone 20 e nome 16/500 em `ink-dim`,
// que viram `ink` no hover e `ink-strong` quando é o canal aberto. No hover, o convite e a
// engrenagem.
component ChannelLine inherits Rectangle {
    in property <ChannelRow> item;
    in property <bool> on;
    callback clicked();

    height: Theme.channel-row;
    border-radius: 4px;
    background: root.on ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);

    animate background { duration: 100ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;

        Glyph {
            commands: root.item.voice ? Icons.speaker : Icons.hash;
            size: 20px;
            tint: root.on ? Theme.ink-strong : Theme.ink-dim;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.item.name;
            color: root.on ? Theme.ink-strong : (touch.has-hover ? Theme.ink : Theme.ink-dim);
            font-size: Theme.list-size;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.item.voice && root.item.limit > 0 : Meta {
            text: root.item.people.length + "/" + root.item.limit;
            vertical-alignment: center;
        }

        if touch.has-hover && Ui.can-invite : FlatIcon {
            commands: Icons.user-plus;
            size: 20px;
            glyph-size: 16px;
            hint: "Criar convite";
            y: (parent.height - self.height) / 2;
            clicked => { Ui.open-modal("invite", -1); }
        }

        if touch.has-hover && Ui.can-manage-channels : FlatIcon {
            commands: Icons.gear;
            size: 20px;
            glyph-size: 16px;
            hint: "Editar canal";
            y: (parent.height - self.height) / 2;
            clicked => { Ui.open-modal("channel-edit", root.item.index); }
        }
    }
}

// Uma pessoa embaixo do canal de voz: 30 de altura, recuo de 36, avatar 24 com o anel de
// quem fala, e à direita o mic cortado, o fone cortado, o selo e a câmera.
component VoicePerson inherits Rectangle {
    in property <int> user-id;
    in property <string> name;
    in property <string> initial;
    in property <bool> mine;
    in property <bool> speaking;
    in property <bool> muted;
    in property <bool> deafened;
    in property <bool> server-muted;
    in property <bool> live;
    in property <bool> camera;
    in property <bool> reconnecting;
    in property <bool> in-my-voice;
    in property <bool> local-muted;
    in property <ActionsRow> actions;
    in property <string> origin-id;
    in property <bool> can-move-from;
    callback live-clicked();

    height: Theme.voice-person-row;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                menu.show();
            }
        }
    }

    HorizontalLayout {
        padding-left: 28px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;

            Avatar {
                letter: root.initial;
                size: 24px;
                mine: root.mine;
            }

            Rectangle {
                x: -2px;
                y: -2px;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                border-width: 2px;
                border-color: Theme.online;
                opacity: root.speaking ? 1.0 : 0.0;

                animate opacity { duration: 120ms; easing: ease-out; }
            }
        }

        Text {
            text: root.name;
            color: root.reconnecting ? Theme.ink-ghost : Theme.ink-soft;
            font-size: Theme.voice-person-size;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.reconnecting : Meta {
            text: "voltando";
            vertical-alignment: center;
        }

        if root.live : LivePill {
            clickable: true;
            y: (parent.height - self.height) / 2;
            clicked => { root.live-clicked(); }
        }

        if root.camera : Glyph {
            commands: Icons.camera;
            size: 16px;
            tint: Theme.ink-dim;
            y: (parent.height - self.height) / 2;
        }

        // O fone cortado por cima do microfone cortado: quem não ouve também não conversa.
        if root.deafened : Glyph {
            commands: Icons.headphones-off;
            size: 16px;
            tint: Theme.ink-dim;
            y: (parent.height - self.height) / 2;
        }

        if !root.deafened && (root.muted || root.server-muted) : Glyph {
            commands: Icons.mic-off;
            size: 16px;
            tint: root.server-muted ? Theme.danger : Theme.ink-dim;
            y: (parent.height - self.height) / 2;
        }
    }

    menu := PopupWindow {
        x: 36px;
        y: root.height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        PersonMenu {
            user-id: root.user-id;
            name: root.name;
            mine: root.mine;
            actions: root.actions;
            in-my-voice: root.in-my-voice;
            local-muted: root.local-muted;
            origin-id: root.origin-id;
            can-move-from: root.can-move-from;
            done => { menu.close(); }
        }
    }
}

// O canal de voz com quem está dentro. Na minha voz a lista vem da sala (ao vivo, com quem
// fala); nas outras, do Laravel pelo tempo real.
component VoiceLine inherits VerticalLayout {
    in property <ChannelRow> item;
    property <bool> here: Ui.voice-channel == root.item.id && root.item.id != "";

    spacing: 0px;

    ChannelLine {
        item: root.item;
        on: root.here;
        clicked => { Ui.open-channel(root.item.index); }
    }

    if root.here : VerticalLayout {
        for peer in Ui.peers : VoicePerson {
            user-id: peer.user-id;
            name: peer.name;
            initial: peer.initial;
            mine: peer.mine;
            speaking: peer.speaking;
            muted: peer.muted;
            deafened: peer.mine && Ui.deafened;
            server-muted: peer.actions.server-muted;
            live: peer.sharing && !peer.mine;
            camera: peer.camera;
            reconnecting: peer.reconnecting;
            in-my-voice: true;
            local-muted: peer.local-muted;
            actions: peer.actions;
            origin-id: root.item.id;
            can-move-from: root.item.can-move-from;
            live-clicked => { Ui.stage-open = true; }
        }
    }

    if !root.here : VerticalLayout {
        for person in root.item.people : VoicePerson {
            user-id: person.user-id;
            name: person.name;
            initial: person.initial;
            mine: person.mine;
            muted: person.muted;
            server-muted: person.actions.server-muted;
            live: person.live;
            camera: person.camera;
            actions: person.actions;
            origin-id: root.item.id;
            can-move-from: root.item.can-move-from;
            live-clicked => { Ui.open-channel(root.item.index); }
        }
    }
}

// O cabeçalho de 48 com o nome do servidor e a seta que abre o menu.
component ServerHeader inherits Rectangle {
    height: Theme.header;
    background: Theme.surface-side;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #04040533;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;

        Text {
            text: Ui.server-name;
            color: Theme.ink-strong;
            font-size: Theme.header-size;
            font-weight: 600;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        Glyph {
            commands: Icons.chevron-down;
            size: 18px;
            tint: Theme.ink-strong;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }

    Rectangle {
        visible: touch.has-hover;
        background: Theme.hover;
    }

    menu := PopupWindow {
        x: 8px;
        y: root.height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        MenuSheet {
            width: 224px;

            if Ui.can-invite : MenuItem {
                text: "Convidar pessoas";
                clicked => {
                    Ui.open-modal("invite", -1);
                    menu.close();
                }
            }

            if Ui.can-manage-server || Ui.can-manage-roles || Ui.can-ban || Ui.can-audit : MenuItem {
                text: "Configurações do servidor";
                clicked => {
                    Ui.open-server-settings("overview");
                    menu.close();
                }
            }

            if Ui.can-manage-channels : MenuItem {
                text: "Criar canal";
                clicked => {
                    Ui.open-modal("channel-new", -1);
                    menu.close();
                }
            }

            MenuLine { }

            if !Ui.is-owner : MenuItem {
                text: "Sair do servidor";
                danger: true;
                clicked => {
                    Ui.ask("leave-server", 0);
                    menu.close();
                }
            }

            if Ui.is-owner : MenuItem {
                text: "Excluir servidor";
                danger: true;
                clicked => {
                    Ui.ask("delete-server", 0);
                    menu.close();
                }
            }
        }
    }
}

component ChannelColumn inherits Rectangle {
    width: Theme.channels;
    background: Theme.surface-side;

    VerticalLayout {
        ServerHeader { }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;
                alignment: start;

                CategoryHead {
                    text: "CANAIS DE TEXTO";
                    can-add: Ui.can-manage-channels;
                    add => { Ui.open-modal("channel-new", -1); }
                }

                for channel in Ui.text-channels : ChannelLine {
                    item: channel;
                    on: channel.current;
                    clicked => { Ui.open-channel(channel.index); }
                }

                Rectangle { height: 8px; }

                CategoryHead {
                    text: "CANAIS DE VOZ";
                    can-add: Ui.can-manage-channels;
                    add => { Ui.open-modal("channel-new", -1); }
                }

                for channel in Ui.voice-channels : VoiceLine {
                    item: channel;
                }
            }
        }

        UserBar { }
    }
}

// ---- a Home: a coluna de amigos e conversas ----

component HomeRow inherits Rectangle {
    in property <string> commands;
    in property <string> label;
    in property <bool> on;
    in property <int> count;
    callback clicked();

    height: 42px;
    border-radius: 4px;
    background: root.on ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        Glyph {
            commands: root.commands;
            size: 24px;
            tint: root.on ? Theme.ink-strong : Theme.ink-dim;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.label;
            color: root.on ? Theme.ink-strong : (touch.has-hover ? Theme.ink : Theme.ink-dim);
            font-size: Theme.list-size;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.count > 0 : Rectangle {
            width: max(16px, count.preferred-width + 8px);
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Theme.danger-fill;

            count := Text {
                text: root.count;
                color: #ffffff;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component HomeColumn inherits Rectangle {
    width: Theme.channels;
    background: Theme.surface-side;

    VerticalLayout {
        Rectangle {
            height: Theme.header;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #04040533;
            }

            HorizontalLayout {
                padding: 8px;

                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: Theme.surface-rail;

                    Text {
                        text: "Salas por código";
                        color: Theme.ink-dim;
                        font-size: 14px;
                        font-weight: 500;
                        x: 8px;
                        vertical-alignment: center;
                        height: parent.height;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.home-tab = "servers"; }
                    }
                }
            }
        }

        VerticalLayout {
            padding: 8px;
            spacing: 2px;

            HomeRow {
                commands: Icons.users;
                label: "Amigos";
                on: Ui.home-tab == "friends";
                count: Ui.pending-count;
                clicked => {
                    Ui.home-tab = "friends";
                    Ui.load-friends();
                }
            }
        }

        CategoryHead {
            text: "MENSAGENS DIRETAS";
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                alignment: start;

                if Ui.conversations.length == 0 : Meta {
                    text: "Nenhuma conversa ainda.";
                    x: 8px;
                }

                for conversation[index] in Ui.conversations : Rectangle {
                    height: 42px;
                    border-radius: 4px;
                    background: Ui.home-tab == "direct" && Ui.talking-name == conversation.name
                        ? Theme.selected
                        : (talk.has-hover ? Theme.hover : transparent);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;

                        Avatar {
                            letter: conversation.initial;
                            size: 32px;
                            y: (parent.height - self.height) / 2;
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: conversation.name;
                                color: Theme.ink;
                                font-size: Theme.list-size;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Meta { text: conversation.last; }
                        }

                        if conversation.unread > 0 : Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 8px;
                            background: Theme.danger-fill;

                            Text {
                                text: conversation.unread;
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    talk := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.open-conversation(index); }
                    }
                }
            }
        }

        UserBar { }
    }
}

// ---- o chat ----

// Uma mensagem: início de grupo com avatar 40 e nome na cor do cargo; continuação só com o
// texto, recuada em 72. No hover, a barra de ações flutua no canto.
component Said inherits Rectangle {
    in property <int> id;
    in property <string> author;
    in property <string> initial;
    in property <string> body;
    in property <string> at;
    in property <bool> mine;
    in property <bool> continued;
    in property <color> role-color;
    in property <bool> colored;
    /// Mensagens diretas não se editam por aqui.
    in property <bool> editable: true;
    property <bool> editing;

    height: line.preferred-height;
    background: hover.has-hover ? #0202020F : transparent;

    hover := TouchArea { }

    line := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: root.continued ? 2px : 10px;
        padding-bottom: 2px;
        spacing: 16px;

        if !root.continued : Avatar {
            letter: root.initial;
            size: 40px;
            mine: root.mine;
            y: 2px;
        }

        if root.continued : Rectangle {
            width: 40px;

            if hover.has-hover : Text {
                text: root.at;
                color: Theme.ink-dim;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: 22px;
            }
        }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            if !root.continued : HorizontalLayout {
                spacing: 6px;
                alignment: start;
                height: 22px;

                Text {
                    text: root.author;
                    color: root.colored ? root.role-color : Theme.ink-strong;
                    font-size: 16px;
                    font-weight: 500;
                    vertical-alignment: center;
                }

                Meta {
                    text: root.at;
                    vertical-alignment: center;
                }
            }

            if !root.editing : Text {
                text: root.body;
                color: Theme.ink;
                font-size: Theme.body-size;
                wrap: word-wrap;
            }

            if root.editing : VerticalLayout {
                spacing: 4px;

                DField {
                    text: root.body;
                    placeholder: "Escreva a mensagem";
                    accepted => {
                        Ui.edit-message(root.id, self.text);
                        root.editing = false;
                    }
                }

                Meta { text: "Enter para salvar · Esc para cancelar"; }
            }
        }
    }

    // A barra de ações: só na minha mensagem, no canto de cima.
    if root.mine && root.editable && hover.has-hover && !root.editing : Rectangle {
        x: parent.width - self.width - 16px;
        y: -12px;
        width: 72px;
        height: 36px;
        border-radius: 8px;
        background: Theme.surface-chat;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #0000003d;

        HorizontalLayout {
            padding: 2px;
            spacing: 2px;

            FlatIcon {
                commands: Icons.gear;
                hint: "Editar";
                clicked => { root.editing = true; }
            }

            FlatIcon {
                commands: Icons.trash;
                hint: "Excluir mensagem";
                alert: true;
                clicked => { Ui.delete-message(root.id); }
            }
        }
    }

    FocusScope {
        enabled: root.editing;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.editing = false;

                return accept;
            }

            return reject;
        }
    }
}

// O composer: margem 0 16 24, `surface-input`, raio 8, 44 de altura.
component Composer inherits Rectangle {
    in property <string> placeholder;
    callback sent(string);

    height: 68px;

    Rectangle {
        x: 16px;
        y: 0;
        width: parent.width - 32px;
        height: 44px;
        border-radius: 8px;
        background: Theme.surface-input;

        input := TextInput {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            color: Theme.ink;
            font-size: Theme.body-size;
            single-line: true;
            vertical-alignment: center;
            accepted => {
                root.sent(self.text);
                self.text = "";
            }
        }

        Text {
            x: 16px;
            text: root.placeholder;
            visible: input.text == "";
            color: Theme.ink-dim;
            font-size: Theme.body-size;
            vertical-alignment: center;
            height: parent.height;
        }
    }
}

component ChatHeader inherits Rectangle {
    in property <bool> voice;
    in property <bool> can-toggle-members;

    height: Theme.header;
    background: Theme.surface-chat;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #04040533;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 8px;

        Glyph {
            commands: root.voice ? Icons.speaker : Icons.hash;
            size: 24px;
            tint: Theme.ink-dim;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: Ui.channel-name;
            color: Theme.ink-strong;
            font-size: Theme.header-size;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        if Ui.channel-topic != "" : Rectangle {
            width: 1px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            background: Theme.line;
        }

        if Ui.channel-topic != "" : Text {
            text: Ui.channel-topic;
            color: Theme.ink-dim;
            font-size: 14px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Rectangle { horizontal-stretch: 1; }

        if root.can-toggle-members : FlatIcon {
            commands: Icons.users;
            hint: "Lista de membros";
            on: Ui.members-open;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.members-open = !Ui.members-open; }
        }
    }
}

component ChatCenter inherits Rectangle {
    in property <bool> can-toggle-members;

    background: Theme.surface-chat;

    VerticalLayout {
        ChatHeader {
            can-toggle-members: root.can-toggle-members;
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: end;
                padding-bottom: 8px;

                // O começo do canal, como o Discord: a boas-vindas acima da primeira mensagem.
                if Ui.channel-name != "" : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Rectangle {
                        width: 68px;
                        height: 68px;
                        border-radius: 34px;
                        background: Theme.surface-input;

                        Glyph {
                            commands: Icons.hash;
                            size: 40px;
                            tint: Theme.ink-strong;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Text {
                        text: "Bem-vindo(a) a #" + Ui.channel-name + "!";
                        color: Theme.ink-strong;
                        font-size: Theme.welcome-size;
                        font-weight: 800;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Este é o começo do canal #" + Ui.channel-name + ".";
                        color: Theme.ink-dim;
                        font-size: Theme.body-size;
                        wrap: word-wrap;
                    }
                }

                if Ui.channel-name == "" : VerticalLayout {
                    padding: 16px;

                    Meta { text: "Escolha um canal de texto para ler as mensagens."; }
                }

                for message in Ui.messages : Said {
                    id: message.id;
                    author: message.author;
                    initial: message.initial;
                    body: message.body;
                    at: message.at;
                    mine: message.mine;
                    continued: message.continued;
                    role-color: message.color;
                    colored: message.colored;
                }
            }
        }

        if Ui.complaint != "" : Text {
            text: Ui.complaint;
            color: Theme.danger;
            font-size: 14px;
            x: 16px;
            wrap: word-wrap;
        }

        Composer {
            placeholder: Ui.channel-name == "" ? "Escolha um canal" : "Conversar em #" + Ui.channel-name;
            sent(body) => { Ui.send-message(body); }
        }
    }
}

// ---- a Home: o miolo ----

component HomeCenter inherits Rectangle {
    background: Theme.surface-chat;

    VerticalLayout {
        Rectangle {
            height: Theme.header;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #04040533;
            }

            HorizontalLayout {
                padding-left: 16px;
                spacing: 8px;

                Glyph {
                    commands: Ui.home-tab == "friends" ? Icons.users : (Ui.home-tab == "direct" ? Icons.chat : Icons.home);
                    size: 24px;
                    tint: Theme.ink-dim;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: Ui.home-tab == "friends" ? "Amigos" : (Ui.home-tab == "direct" ? Ui.talking-name : "Home");
                    color: Theme.ink-strong;
                    font-size: Theme.header-size;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        if Ui.complaint != "" : Text {
            text: Ui.complaint;
            color: Theme.danger;
            font-size: 14px;
            x: 16px;
            wrap: word-wrap;
        }

        // ---- salas ----
        if Ui.home-tab == "servers" : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 32px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: Ui.servers.length == 0 ? "Você ainda não está em nenhum servidor." : "Oi, " + Ui.user-name + ".";
                    color: Theme.ink-strong;
                    font-size: Theme.title-size;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: "Um servidor é onde você e seus amigos se reúnem: canais de texto, voz, câmera e tela.";
                    color: Theme.ink-dim;
                    font-size: Theme.body-size;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    DButton {
                        text: "Criar servidor";
                        width: 160px;
                        clicked => { Ui.open-modal("server-new", -1); }
                    }

                    DButton {
                        text: "Entrar com convite";
                        kind: "secondary";
                        width: 160px;
                        clicked => { Ui.open-modal("server-join", -1); }
                    }
                }

                Rectangle { height: 16px; }

                Label { text: "SALAS POR CÓDIGO"; }

                Text {
                    text: "Sem conta, sem servidor: um código de 12 letras é a sala. Quem tem o código entra.";
                    color: Theme.ink-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    DButton {
                        text: "Criar sala por código";
                        kind: "secondary";
                        width: 200px;
                        clicked => { Ui.show-entry(); }
                    }
                }

                if Ui.recent-rooms.length > 0 : Label { text: "ÚLTIMAS SALAS"; }

                for codes in Ui.recent-rooms : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    for code in codes : Rectangle {
                        height: 32px;
                        width: chip.preferred-width + 24px;
                        border-radius: 4px;
                        background: again.has-hover ? Theme.selected : Theme.surface-input;

                        chip := Text {
                            text: code;
                            color: Theme.ink;
                            font-family: Skin.mono;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        again := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Ui.open-recent-room(code); }
                        }
                    }
                }
            }
        }

        // ---- amigos ----
        if Ui.home-tab == "friends" : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: start;

                Label { text: "ADICIONAR AMIGO"; }

                Text {
                    text: "Adicione pela conta: o e-mail é o que o servidor conhece.";
                    color: Theme.ink-dim;
                    font-size: 14px;
                }

                mate := DField {
                    placeholder: "e-mail de quem você quer adicionar";
                    accepted => {
                        Ui.add-friend(mate.text);
                        mate.text = "";
                    }
                }

                Rectangle { height: 8px; }

                Label { text: "TODOS — " + Ui.friends.length; }

                if Ui.friends.length == 0 : Meta { text: "Nenhum amigo ainda."; }

                for friend[index] in Ui.friends : Rectangle {
                    height: 62px;
                    border-radius: 8px;
                    background: row.has-hover ? Theme.hover : transparent;

                    row := TouchArea { }

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;

                        Avatar {
                            letter: friend.initial;
                            size: 32px;
                            y: (parent.height - self.height) / 2;
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: friend.name;
                                color: Theme.ink-strong;
                                font-size: Theme.list-size;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Meta {
                                text: friend.state == "accepted" ? "Amigo" : (friend.state == "incoming" ? "Pedido recebido" : (friend.state == "waiting" ? "Pedido enviado" : "Bloqueado"));
                            }
                        }

                        if friend.state == "accepted" : FlatIcon {
                            commands: Icons.chat;
                            hint: "Mensagem";
                            size: 36px;
                            y: (parent.height - self.height) / 2;
                            clicked => { Ui.talk-to-friend(index); }
                        }

                        if friend.state == "incoming" : FlatIcon {
                            commands: Icons.check;
                            hint: "Aceitar";
                            size: 36px;
                            y: (parent.height - self.height) / 2;
                            clicked => { Ui.answer-friend(friend.id, true); }
                        }

                        if friend.state == "incoming" : FlatIcon {
                            commands: Icons.close;
                            hint: "Recusar";
                            alert: true;
                            size: 36px;
                            y: (parent.height - self.height) / 2;
                            clicked => { Ui.answer-friend(friend.id, false); }
                        }
                    }
                }
            }
        }

        // ---- a conversa aberta ----
        if Ui.home-tab == "direct" : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: end;
                padding-bottom: 8px;

                for said in Ui.direct-messages : Said {
                    author: said.author;
                    initial: said.initial;
                    body: said.body;
                    at: said.at;
                    mine: said.mine;
                    continued: said.continued;
                    editable: false;
                }
            }
        }

        if Ui.home-tab == "direct" : Composer {
            placeholder: "Conversar com @" + Ui.talking-name;
            sent(body) => { Ui.send-direct(body); }
        }
    }
}

// ---- a lista de membros ----

component MemberLine inherits Rectangle {
    in property <MemberRow> member;
    in property <color> role-color;
    in property <bool> colored;
    in property <bool> offline;

    height: Theme.member-row;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;
    opacity: root.offline ? 0.3 : 1.0;

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                menu.show();
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;

            Avatar {
                letter: root.member.initial;
                size: 32px;
                mine: root.member.mine;
            }

            StatusDot {
                online: !root.offline;
                x: 20px;
                y: 20px;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.member.name;
                    color: root.colored && !root.offline ? root.role-color : Theme.ink-soft;
                    font-size: Theme.list-size;
                    font-weight: 500;
                    overflow: elide;
                }

                if root.member.owner : Glyph {
                    commands: Icons.crown;
                    size: 14px;
                    tint: Theme.idle;
                    y: (parent.height - self.height) / 2;
                }
            }

            if root.member.note != "" : Meta { text: root.member.note; }
        }
    }

    menu := PopupWindow {
        x: 8px;
        y: root.height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        PersonMenu {
            user-id: root.member.user-id;
            name: root.member.name;
            mine: root.member.mine;
            actions: root.member.actions;
            can-move-from: root.member.actions.disconnect;
            done => { menu.close(); }
        }
    }
}

component MemberList inherits Rectangle {
    width: Theme.members;
    background: Theme.surface-side;

    ScrollView {
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;
            spacing: 0px;
            alignment: start;

            for group in Ui.member-groups : VerticalLayout {
                spacing: 2px;

                Label {
                    text: group.label + " — " + group.members.length;
                    color: group.colored ? group.color : Theme.ink-dim;
                    x: 8px;
                    height: 36px;
                    vertical-alignment: bottom;
                }

                Rectangle { height: 4px; }

                for member in group.members : MemberLine {
                    member: member;
                    role-color: group.color;
                    colored: group.colored;
                    offline: group.offline;
                }
            }
        }
    }
}

export component HubScreen inherits Rectangle {
    // Na voz com a chamada aberta, o centro é a chamada e a lista de membros some.
    property <bool> calling: Ui.in-server && Ui.voice-channel != "" && Ui.stage-open;
    // Abaixo de 1100 a lista começa fechada: o botão do cabeçalho inverte o padrão da
    // largura em que se está.
    property <bool> narrow: root.width < Theme.narrow;
    property <bool> members-shown: Ui.members-open != root.narrow;

    background: Theme.surface-chat;

    HorizontalLayout {
        Rail { }

        if !Ui.in-server : HomeColumn { }
        if !Ui.in-server : HomeCenter { horizontal-stretch: 1; }

        if Ui.in-server : ChannelColumn { }

        if Ui.in-server && !root.calling : ChatCenter {
            horizontal-stretch: 1;
            can-toggle-members: true;
        }

        if Ui.in-server && !root.calling && root.members-shown : MemberList { }

        if root.calling : Call { horizontal-stretch: 1; }

        if root.calling && Ui.voice-chat-open : VoiceChat { width: Theme.voice-chat; }
    }
}
