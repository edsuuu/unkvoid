// A paleta e as medidas são as de `native/apps/desktop/ui/style.css`, valor por valor: o
// CSS é o que está no ar hoje, e divergir aqui faz o app do Windows parecer outro programa.
//
// `Skin` e não `Palette`: `Palette` é nome do `std-widgets`, e os dois no mesmo arquivo se
// atropelam.
export global Skin {
    out property <color> back: #06050a;
    out property <color> glass: #ffffff0a;
    out property <color> row: #ffffff0f;
    out property <color> line: #ffffff17;
    out property <color> line-strong: #ffffff1f;

    out property <color> ink: #ece9f3;
    out property <color> ink-strong: #ffffff;
    out property <color> ink-body: #e6e1f2;
    out property <color> ink-icon: #cfc9de;
    out property <color> ink-soft: #a89fc0;
    out property <color> ink-dim: #8a80a6;
    out property <color> ink-faint: #6f6889;

    out property <color> brand: #8a7cf5;
    out property <color> brand-dark: #5a3fd6;
    out property <color> lilac: #9a9cff;
    out property <color> lilac-2: #aeb0ff;
    out property <color> online: #34d399;
    out property <color> danger: #e2445c;

    // A cadeia do CSS é `Archivo, Helvetica, Arial`. O projeto não distribui a Archivo, e
    // cair na Segoe UI daria outra tipografia ao app.
    out property <string> sans: "Archivo";
    // A monoespaçada ficou só no código da sala, onde ela separa 0 de O.
    out property <string> mono: "IBM Plex Mono";

    out property <length> card: 420px;
    out property <length> stage: 880px;
}

