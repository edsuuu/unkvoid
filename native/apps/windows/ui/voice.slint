import { ScrollView } from "std-widgets.slint";
import { Icons, Skin, Theme } from "skin.slint";
import { Ui } from "state.slint";
import { Avatar, DButton, FlatIcon, Glyph, Label, Meta, Tip } from "widgets.slint";
import { Stage } from "stage.slint";

// A chamada dentro do servidor: fundo preto, o cabeçalho transparente por cima, a grade e a
// barra de controle de botões redondos embaixo. É a `room/Stage.tsx` no desenho do Discord.

// Um botão redondo de 56 da barra: `surface-side` em repouso; ligado é branco com o ícone
// preto; mutado é vermelho com o ícone cortado em branco.
component RoundButton inherits Rectangle {
    in property <string> commands;
    in property <string> hint;
    in property <bool> on;
    in property <bool> off;
    in property <bool> hangup;
    in property <bool> enabled: true;
    in property <bool> filled;
    callback clicked();

    width: 56px;
    height: 56px;
    border-radius: 28px;
    background: root.hangup || root.off
        ? (touch.has-hover ? #A12D2F : Theme.danger-fill)
        : root.on
            ? Theme.ink-strong
            : (touch.has-hover ? Theme.call-hover : Theme.surface-side);
    opacity: root.enabled ? 1.0 : 0.4;

    animate background { duration: 100ms; }

    Glyph {
        commands: root.commands;
        size: 24px;
        filled: root.filled;
        tint: root.on && !root.off && !root.hangup ? #000000 : #ffffff;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if touch.has-hover && root.hint != "" : Tip {
        text: root.hint;
        y: -40px;
        x: (parent.width - self.width) / 2;
    }
}

export component Call inherits Rectangle {
    background: Theme.surface-call;

    VerticalLayout {
        // O cabeçalho transparente: o alto-falante, o canal, e à direita o chat e a volta.
        Rectangle {
            height: Theme.header;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 8px;

                Glyph {
                    commands: Icons.speaker;
                    size: 24px;
                    tint: Theme.ink-dim;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: Ui.voice-name;
                    color: Theme.ink-strong;
                    font-size: Theme.header-size;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                if Ui.focusing : DButton {
                    text: "Sair do foco";
                    kind: "secondary";
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.toggle-focus(""); }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: (parent.height - self.height) / 2;

                    FlatIcon {
                        commands: Icons.chat;
                        hint: "Chat da voz";
                        on: Ui.voice-chat-open;
                        clicked => { Ui.toggle-voice-chat(); }
                    }

                    if Ui.voice-chat-unread > 0 : Rectangle {
                        x: parent.width - 8px;
                        y: -2px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.danger-fill;
                    }
                }

                FlatIcon {
                    commands: Icons.hash;
                    hint: "Voltar ao chat do canal";
                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.stage-open = false; }
                }
            }
        }

        Stage {
            vertical-stretch: 1;
        }

        // A barra de controle: Câmera, Tela, Microfone, Ensurdecer e, separado, Sair.
        Rectangle {
            height: 88px;

            HorizontalLayout {
                alignment: center;
                spacing: 16px;
                padding-top: 8px;

                // ponytail: a câmera ainda não abre fora do macOS; o botão fica apagado.
                RoundButton {
                    commands: Icons.camera-off;
                    hint: "A câmera ainda não está ligada nesta versão";
                    enabled: false;
                    clicked => { Ui.toggle-camera(); }
                }

                RoundButton {
                    commands: Icons.screen;
                    hint: Ui.sharing ? "Parar de compartilhar" : "Compartilhar tela";
                    on: Ui.sharing;
                    enabled: Ui.can-share;
                    clicked => { Ui.toggle-share(); }
                }

                RoundButton {
                    commands: Ui.mic-on ? Icons.mic : Icons.mic-off;
                    hint: Ui.can-speak ? (Ui.mic-on ? "Mutar" : "Desmutar") : "Mutado pelo servidor";
                    off: !Ui.mic-on;
                    enabled: Ui.can-speak;
                    clicked => { Ui.toggle-mic(); }
                }

                RoundButton {
                    commands: Ui.deafened ? Icons.headphones-off : Icons.headphones;
                    hint: Ui.deafened ? "Voltar a ouvir" : "Ensurdecer";
                    off: Ui.deafened;
                    clicked => { Ui.toggle-deafen(); }
                }

                Rectangle { width: 16px; }

                RoundButton {
                    commands: Icons.phone-off;
                    filled: true;
                    hint: "Sair da voz";
                    hangup: true;
                    clicked => { Ui.leave-voice(); }
                }
            }
        }
    }
}

// O chat da voz: a gaveta de 360 à direita da chamada.
export component VoiceChat inherits Rectangle {
    background: Theme.surface-chat;

    VerticalLayout {
        Rectangle {
            height: Theme.header;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #04040533;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    text: "Chat da voz";
                    color: Theme.ink-strong;
                    font-size: Theme.header-size;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                FlatIcon {
                    commands: Icons.close;
                    hint: "Fechar";
                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.voice-chat-open = false; }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: end;
                padding: 8px;
                spacing: 8px;

                if Ui.voice-messages.length == 0 : Meta {
                    text: "Nenhuma mensagem nesta voz ainda.";
                    x: 8px;
                }

                for message in Ui.voice-messages : HorizontalLayout {
                    spacing: 12px;
                    padding-left: 8px;
                    padding-right: 8px;

                    if !message.continued : Avatar {
                        letter: message.initial;
                        size: 32px;
                        mine: message.mine;
                        y: 0;
                    }

                    if message.continued : Rectangle { width: 32px; }

                    VerticalLayout {
                        horizontal-stretch: 1;

                        if !message.continued : HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: message.author;
                                color: message.colored ? message.color : Theme.ink-strong;
                                font-size: 14px;
                                font-weight: 500;
                            }

                            Meta { text: message.at; vertical-alignment: center; }
                        }

                        Text {
                            text: message.body;
                            color: Theme.ink;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 60px;

            Rectangle {
                x: 8px;
                y: 4px;
                width: parent.width - 16px;
                height: 44px;
                border-radius: 8px;
                background: Theme.surface-input;

                composer := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    color: Theme.ink;
                    font-size: 14px;
                    single-line: true;
                    vertical-alignment: center;
                    accepted => {
                        Ui.send-voice-message(self.text);
                        self.text = "";
                    }
                }

                Text {
                    x: 16px;
                    text: "Conversar em " + Ui.voice-name;
                    visible: composer.text == "";
                    color: Theme.ink-dim;
                    font-size: 14px;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }
}
