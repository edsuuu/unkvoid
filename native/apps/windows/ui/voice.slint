import { Icons, Skin } from "skin.slint";
import { Ui } from "state.slint";
import { Glass, Glyph, IconButton } from "widgets.slint";
import { PeopleMenu, Stage } from "stage.slint";

// A voz dentro do servidor: o palco que toma o lugar do chat, e a sala focada que toma tudo
// menos a trilha. É o `VoiceStage` e o `VoiceToolbar` do macOS (`Screens/HubScreen.swift`).

// O `GhostButton` pequeno do Mac: ícone e texto em 12, respiro de 6 por 10.
component SmallGhost inherits Rectangle {
    in property <string> commands;
    in property <string> text;
    in property <bool> on;
    // Mensagem nova: a bolinha vermelha no canto.
    in property <bool> fresh;
    callback clicked();

    width: row.preferred-width + 20px;
    height: 30px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.on || touch.has-hover ? #8a7cf580 : Skin.line-strong;
    background: #ffffff0d;

    row := HorizontalLayout {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        spacing: 6px;

        if root.commands != "" : Glyph {
            commands: root.commands;
            size: 13px;
            tint: root.on || touch.has-hover ? Skin.ink-strong : Skin.ink-icon;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.on || touch.has-hover ? Skin.ink-strong : Skin.ink-icon;
            font-family: Skin.sans;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    if root.fresh : Rectangle {
        x: parent.width - 7px;
        y: -3px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Skin.danger;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// O palco da voz dentro do servidor: o nome do canal, o caminho de volta ao chat e as
// transmissões de quem está lá.
export component VoiceStage inherits Glass {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Glyph {
                commands: Icons.speaker;
                size: 15px;
                tint: Skin.online;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: Ui.voice-name;
                color: Skin.ink;
                font-family: Skin.sans;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            PeopleMenu {
                y: (parent.height - self.height) / 2;
            }

            Rectangle {
                width: chat.width;
                height: chat.height;
                y: (parent.height - self.height) / 2;

                chat := SmallGhost {
                    commands: Icons.chat;
                    text: "Chat da voz";
                    on: Ui.voice-chat-open;
                    clicked => { Ui.toggle-voice-chat(); }
                }

                if Ui.voice-chat-unread > 0 : Rectangle {
                    x: parent.width - 6px;
                    y: -4px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Skin.danger;
                }
            }

            SmallGhost {
                commands: Icons.focus;
                text: "Sala focada";
                y: (parent.height - self.height) / 2;
                clicked => { Ui.focused-room = true; }
            }

            SmallGhost {
                text: "Voltar ao chat";
                y: (parent.height - self.height) / 2;
                clicked => { Ui.stage-open = false; }
            }
        }

        Stage {
            vertical-stretch: 1;
        }
    }
}

// `RoomToolbar.tsx` no modo `voice`: voltar aos canais, o canal, quem está, o ping, e
// câmera, microfone, áudio, chat, tela e sair.
export component VoiceToolbar inherits Glass {
    height: 52px;
    border-radius: 16px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        IconButton {
            commands: Icons.arrow-left;
            active: true;
            size: 30px;
            glyph-size: 14px;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.focused-room = false; }
        }

        Glyph {
            commands: Icons.speaker;
            size: 14px;
            tint: Skin.online;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: Ui.voice-name;
            color: Skin.ink;
            font-family: Skin.sans;
            font-size: 13.5px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        PeopleMenu {
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: Ui.ping;
            color: Skin.ink-dim;
            font-family: Skin.mono;
            font-size: 10.5px;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        IconButton {
            commands: Icons.camera-off;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-camera(); }
        }

        IconButton {
            commands: Ui.mic-on ? Icons.mic : Icons.mic-off;
            on: Ui.mic-on;
            enabled: Ui.can-speak;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-mic(); }
        }

        IconButton {
            commands: Ui.deafened ? Icons.headphones-off : Icons.headphones;
            on: !Ui.deafened;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.toggle-deafen(); }
        }

        Rectangle {
            width: talk.width;
            height: talk.height;
            y: (parent.height - self.height) / 2;

            talk := IconButton {
                commands: Icons.chat;
                active: Ui.voice-chat-open;
                clicked => { Ui.toggle-voice-chat(); }
            }

            if Ui.voice-chat-unread > 0 : Rectangle {
                x: parent.width - 6px;
                y: -4px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Skin.danger;
            }
        }

        IconButton {
            commands: Icons.screen;
            active: Ui.sharing;
            enabled: Ui.can-share;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.open-share(); }
        }

        IconButton {
            commands: Icons.phone-off;
            hangup: true;
            filled: true;
            y: (parent.height - self.height) / 2;
            clicked => { Ui.leave-voice(); }
        }
    }
}
