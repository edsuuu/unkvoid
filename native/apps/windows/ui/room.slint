import { ScrollView } from "std-widgets.slint";
import { Icons, Skin } from "skin.slint";
import { Ui } from "state.slint";
import { Avatar, CodeChip, Danger, Glass, Glyph, IconButton, LabelMono, Pill, RowItem } from "widgets.slint";
import { PeopleMenu, Stage } from "stage.slint";

// A sala: o código para mandar a alguém, quem está dentro, e o que está sendo transmitido.
//
// O desenho é o do `apps/desktop/ui/components/room`: uma barra só, em pílula, com o código
// à esquerda e os botões redondos à direita.
//
// **A sala por código não tem voz.** Nada de microfone, som, câmera ou barra de baixo: ela é
// só a tela compartilhada, como no React (`RoomToolbar` só desenha isso no modo `voice`).
export component RoomScreen inherits Rectangle {
    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        Glass {
            height: 52px;
            border-radius: 16px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                LabelMono {
                    text: "SALA";
                    vertical-alignment: center;
                }

                // O chip é um `TextInput` só de leitura: seleciona e copia pelo teclado. O
                // desenho de copiar do React entra quando a ponte do Windows tiver para onde
                // mandar o texto — botão que não copia é pior que botão nenhum.
                CodeChip {
                    text: Ui.room-code;
                    y: (parent.height - self.height) / 2;
                }

                PeopleMenu {
                    y: (parent.height - self.height) / 2;
                }

                Pill {
                    width: 96px;
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        x: 12px;
                        y: (parent.height - self.height) / 2;
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: Skin.online;
                    }

                    Text {
                        x: 27px;
                        text: Ui.elapsed;
                        color: Skin.ink-icon;
                        font-family: Skin.mono;
                        font-size: 11px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }

                Text {
                    text: Ui.ping;
                    color: Skin.ink-dim;
                    font-family: Skin.mono;
                    font-size: 10.5px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Transmitindo, o React põe um "Parar" de texto ao lado do ícone.
                Rectangle {
                    visible: Ui.sharing;
                    width: Ui.sharing ? 92px : 0px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: #e2445c59;
                    background: #e2445c1f;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Glyph {
                            commands: Icons.stop;
                            size: 18px;
                            filled: true;
                            tint: Skin.danger;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Parar";
                            color: Skin.danger;
                            font-family: Skin.sans;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.toggle-share(); }
                    }
                }

                IconButton {
                    commands: Icons.screen;
                    active: Ui.sharing;
                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.toggle-share(); }
                }

                IconButton {
                    commands: Icons.phone-off;
                    hangup: true;
                    filled: true;

                    y: (parent.height - self.height) / 2;
                    clicked => { Ui.leave-room(); }
                }
            }
        }

        // O palco: o cartão largo quando ninguém transmite, e as telas quando há.
        Rectangle {
            vertical-stretch: 1;

            Stage {
                width: parent.width;
                height: parent.height;
                code: Ui.room-code;
            }

        }

        if Ui.complaint != "" : Danger {
            text: Ui.complaint;
        }
    }
}
