import { Icons, Skin, Theme } from "skin.slint";

// O vocabulário do desenho. Cada um destes existe porque o CSS já o tinha como classe, e
// repetir a cadeia de propriedades em cada tela é como as telas começam a divergir.
//
// O `backdrop-filter` do `.glass` não tem par no Slint: o que sobra é o fundo translúcido
// sobre o halo, que é de onde vem quase toda a aparência.
export component Glass inherits Rectangle {
    background: Skin.glass;
    border-color: Skin.line;
    border-width: 1px;
    border-radius: 20px;
}

export component Title inherits Text {
    color: Skin.ink-strong;
    font-family: Skin.sans;
    font-size: 18px;
    font-weight: 600;
}

export component Body inherits Text {
    color: Skin.ink-body;
    font-family: Skin.sans;
    font-size: 13px;
    wrap: word-wrap;
}

export component Muted inherits Text {
    color: Skin.ink-soft;
    font-family: Skin.sans;
    font-size: 13px;
    wrap: word-wrap;
}

export component Danger inherits Text {
    color: Skin.danger;
    font-family: Skin.sans;
    font-size: 12.5px;
    horizontal-alignment: center;
    wrap: word-wrap;
}

// `.label-mono`: o nome ficou, a monoespaçada saiu. Hoje é `font-sans`, 10.5px, 600.
export component LabelMono inherits Text {
    color: Skin.ink-dim;
    font-family: Skin.sans;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.84px;
}

export component DividerOr inherits HorizontalLayout {
    spacing: 12px;
    Rectangle {
        Rectangle { y: parent.height / 2; background: Skin.line; height: 1px; }
    }
    LabelMono { text: "OU"; vertical-alignment: center; }
    Rectangle {
        Rectangle { y: parent.height / 2; background: Skin.line; height: 1px; }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // A barra dos Clips usa o botão no tamanho do `GhostButton` vizinho.
    in property <length> font-size: 14.5px;
    callback clicked();

    height: 41px;
    min-width: label.preferred-width + 28px;
    border-radius: 12px;
    background: @linear-gradient(180deg, Skin.brand 0%, Skin.brand-dark 100%);
    opacity: root.enabled ? (touch.pressed ? 0.9 : 1.0) : 0.45;

    label := Text {
        text: root.text;
        color: Skin.ink-strong;
        font-family: Skin.sans;
        font-size: root.font-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> font-size: 12.5px;
    callback clicked();

    // 8 de respiro em cima e embaixo, como o `.btn-ghost` do CSS. A largura segue o texto:
    // "Configurações" não cabe nos 72.
    height: 32px;
    min-width: max(72px, label.preferred-width + 28px);
    border-radius: 10px;
    border-width: 1px;
    border-color: touch.has-hover ? #8a7cf580 : Skin.line-strong;
    background: #ffffff0d;
    opacity: root.enabled ? 1.0 : 0.45;

    label := Text {
        text: root.text;
        color: touch.has-hover ? Skin.ink-strong : Skin.ink-icon;
        font-family: Skin.sans;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Glyph inherits Rectangle {
    in property <string> commands;
    in property <brush> tint: Skin.ink-icon;
    in property <length> size: 17px;
    // Os desenhos do React são de linha, menos dois: o fone do "sair" e o triângulo do
    // "assistir" são preenchidos, e um contorno no lugar deles vira outro ícone.
    in property <bool> filled;

    width: root.size;
    height: root.size;

    Path {
        commands: root.commands;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.filled ? transparent : root.tint;
        // O `strokeWidth="1.8"` do React vale dentro do `viewBox` de 24, então encolhe junto
        // com o ícone — como o Mac faz. Em pixels fixos o ícone pequeno virava uma mancha,
        // e sem as pontas redondas cada traço saía cortado.
        stroke-width: root.size * 1.8 / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.tint : transparent;
    }
}

// `.btn-icon`: 34x34, raio 11. `on` é o estado ligado — uma cor só, posta e tirada, porque
// duas cores na mesma regra se resolvem pela ordem do estilo e não pela ordem escrita.
export component IconButton inherits Rectangle {
    in property <string> commands;
    in property <bool> on: true;
    in property <bool> enabled: true;
    // `btn-icon-on`: o estado ligado, no violeta cheio da marca.
    in property <bool> active;
    // O botão de sair: vermelho cheio, sem contorno.
    in property <bool> hangup;
    in property <bool> filled;

    in property <length> size: 34px;
    in property <length> glyph-size: 17px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size == 34px ? 11px : 9px;
    border-width: root.hangup ? 0px : 1px;
    border-color: root.active ? #8a7cf599 : Skin.line-strong;
    background: root.hangup
        ? Skin.danger
        : root.active
            ? @linear-gradient(180deg, Skin.brand 0%, Skin.brand-dark 100%)
            : #ffffff0d;
    opacity: root.enabled ? 1.0 : 0.45;

    Glyph {
        commands: root.commands;
        size: root.glyph-size;
        filled: root.filled;

        tint: root.hangup || root.active
            ? Skin.ink-strong
            : root.on ? Skin.ink-icon : Skin.danger;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A pílula de contorno redondo da barra da sala: o tempo, a contagem, quem está dentro.
export component Pill inherits Rectangle {
    height: 32px;
    border-radius: 999px;
    border-width: 1px;
    border-color: Skin.line-strong;
    background: Skin.row;
}

export component LinkButton inherits Text {
    in property <string> label;
    callback clicked();

    text: root.label;
    color: Skin.lilac;
    font-family: Skin.sans;
    font-size: 12.5px;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// `.field`: raio 12, 14px, padding 11/13. O erro de validação mora aqui embaixo e pinta a
// borda: o dono não quer a frase numa linha solta no rodapé, longe do campo que a causou.
export component Field inherits VerticalLayout {
    in property <string> placeholder;
    in property <string> error;
    in property <bool> mono;
    in property <bool> password;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited();

    spacing: 6px;
    // `focus()` no campo é o `focus()` do que se digita nele.
    forward-focus: input;

    Rectangle {
        height: 40px;
        background: #ffffff08;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.error != ""
            ? Skin.danger
            : (input.has-focus ? #8a7cf580 : #ffffff1a);
        opacity: root.enabled ? 1.0 : 0.55;
        clip: true;

        // O texto longo rola dentro do campo e segue o cursor, como no input do navegador. O
        // `TextInput` não rola sozinho: é a conta do `LineEdit` do próprio Slint, feita aqui
        // para o campo manter o desenho do React.
        Rectangle {
            x: 13px;
            width: parent.width - 26px;
            clip: true;

            input := TextInput {
                property <length> shift;

                x: min(0px, max(parent.width - self.width, self.shift));
                width: max(parent.width, self.preferred-width + 2px);
                height: parent.height;
                color: Skin.ink-strong;
                font-family: root.mono ? Skin.mono : Skin.sans;
                font-size: 14px;
                single-line: true;
                enabled: root.enabled;
                vertical-alignment: center;
                input-type: root.password ? InputType.password : InputType.text;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
                cursor-position-changed(position) => {
                    if position.x + self.shift < 0px {
                        self.shift = -position.x;
                    } else if position.x + self.shift > parent.width - 2px {
                        self.shift = parent.width - 2px - position.x;
                    }
                }
            }
        }

        Text {
            x: 13px;
            text: root.placeholder;
            visible: input.text == "";
            color: Skin.ink-faint;
            font-family: Skin.sans;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    if root.error != "" : Text {
        text: root.error;
        color: Skin.danger;
        font-family: Skin.sans;
        font-size: 11.5px;
        wrap: word-wrap;
    }
}

// O `live-badge` do React: vermelho cheio, mono miúdo e espaçado. No canal de voz ele leva
// o pontinho branco e é clicável (abre a transmissão); no menu de pessoas, não.
export component LiveBadge inherits Rectangle {
    in property <bool> dot;
    callback clicked();

    width: inside.preferred-width + 12px;
    height: 17px;
    border-radius: 5px;
    background: Skin.danger;
    opacity: touch.has-hover && root.dot ? 0.9 : 1.0;

    inside := HorizontalLayout {
        x: 6px;
        spacing: 5px;

        if root.dot : Rectangle {
            width: 5px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            border-radius: 2.5px;
            background: #ffffff;
        }

        Text {
            text: "AO VIVO";
            color: Skin.ink-strong;
            font-family: Skin.mono;
            font-size: 8.5px;
            font-weight: 600;
            letter-spacing: 0.85px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.dot;
        mouse-cursor: root.dot ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// A inicial vem pronta: o Slint não recorta string, e quem sabe recortar é o Rust.
export component Avatar inherits Rectangle {
    in property <string> letter;
    in property <length> size: 32px;
    // Quem não é você não ganha o violeta: ele marca o que é seu na tela.
    in property <bool> mine;
    // O ícone de um servidor é quadrado de canto mole, não redondo — como no React.
    in property <bool> square;

    width: root.size;
    height: root.size;
    border-radius: root.square ? root.size * 0.3 : root.size / 2;
    background: root.mine
        ? @linear-gradient(180deg, Skin.brand 0%, Skin.brand-dark 100%)
        : #ffffff14;

    Text {
        text: root.letter == "" ? "?" : root.letter;
        color: root.mine ? Skin.ink-strong : Skin.ink-icon;
        font-family: Skin.sans;
        // A mesma conta do React: um terço do diâmetro, e nunca menos que 9 — abaixo disso
        // as iniciais somem. Em 0.42 a letra enchia o círculo.
        font-size: max(9px, root.size * 0.33);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// `.row-item`: a linha de lista do app (canal, membro, servidor, aparelho).
export component RowItem inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.on ? #8a7cf552 : #ffffff14;
    background: root.on ? #8a7cf51f : (touch.has-hover ? Skin.row : transparent);

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    @children
}

// `.code-chip`: a única coisa da tela feita para copiar, e por isso um campo de leitura —
// o Ctrl+C é o do próprio Slint, sem área de transferência de terceiros no meio.
export component CodeChip inherits Rectangle {
    in property <string> text;

    height: 26px;
    width: code.preferred-width + 16px;
    border-radius: 7px;
    background: #8a7cf529;

    code := TextInput {
        x: 8px;
        text: root.text;
        read-only: true;
        single-line: true;
        color: Skin.lilac-2;
        font-family: Skin.mono;
        font-size: 13px;
        vertical-alignment: center;
        height: parent.height;
    }
}

// ---- o vocabulário da réplica do Discord ----
//
// Daqui para baixo nada tem vidro: superfícies chapadas do `Theme`, raio 4 ou 8, e a fonte
// do sistema. O de cima continua para a entrada e a sala por código.

// O rótulo em caixa alta: categoria, grupo de membros, rótulo de campo.
export component Label inherits Text {
    color: Theme.ink-dim;
    font-size: Theme.label-size;
    font-weight: 600;
    letter-spacing: 0.24px;
}

// A hora, o "Online", o subtítulo: 12 em 500.
export component Meta inherits Text {
    color: Theme.ink-dim;
    font-size: Theme.meta-size;
    font-weight: 500;
    overflow: elide;
}

// O botão do Discord: `kind` é "primary" (brand), "danger" (danger-fill), "secondary"
// (surface-input) ou "text" (só o texto, sublinha no hover).
export component DButton inherits Rectangle {
    in property <string> text;
    in property <string> kind: "primary";
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    min-width: 96px;
    border-radius: 4px;
    background: root.kind == "primary"
        ? (touch.has-hover ? Theme.brand-hover : Theme.brand)
        : root.kind == "danger"
            ? (touch.has-hover ? #A12D2F : Theme.danger-fill)
            : root.kind == "secondary"
                ? (touch.has-hover ? Theme.selected : Theme.surface-input)
                : transparent;
    opacity: root.enabled ? 1.0 : 0.5;

    animate background { duration: 100ms; }

    Text {
        text: root.text;
        color: root.kind == "text" ? Theme.ink : Theme.ink-strong;
        font-size: Theme.button-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.kind == "text" && touch.has-hover : Rectangle {
        y: parent.height - 9px;
        height: 1px;
        width: parent.width - 32px;
        x: 16px;
        background: Theme.ink;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// O balão do Discord: `surface-float`, 14/600, respiro 8 12, raio 6, na hora.
export component Tip inherits Rectangle {
    in property <string> text;

    width: said.preferred-width + 24px;
    height: 32px;
    border-radius: 6px;
    background: Theme.surface-float;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #0000003d;

    said := Text {
        text: root.text;
        color: Theme.ink;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// O botão quadrado de ícone: 32 de lado, raio 4, fundo `hover` sob o mouse.
export component FlatIcon inherits Rectangle {
    in property <string> commands;
    in property <length> size: 32px;
    in property <length> glyph-size: 20px;
    in property <bool> enabled: true;
    in property <bool> alert;
    in property <bool> on;
    in property <string> hint;
    in property <bool> filled;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 4px;
    background: root.on || touch.has-hover ? Theme.hover : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    animate background { duration: 100ms; }

    Glyph {
        commands: root.commands;
        size: root.glyph-size;
        filled: root.filled;
        tint: root.alert ? Theme.danger : (root.on || touch.has-hover ? Theme.ink-strong : Theme.ink-soft);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if touch.has-hover && root.hint != "" : Tip {
        text: root.hint;
        y: -34px;
        x: (parent.width - self.width) / 2;
    }
}

// O interruptor das configurações: 40×24, verde ligado.
export component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);

    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: root.on ? Theme.online : Theme.offline;

    animate background { duration: 150ms; }

    Rectangle {
        width: 18px;
        height: 18px;
        x: root.on ? 19px : 3px;
        y: 3px;
        border-radius: 9px;
        background: #ffffff;

        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// O campo do Discord: `surface-input`, raio 4, 16 de letra, 40 de altura. Serve ao composer
// e aos modais.
export component DField inherits VerticalLayout {
    in property <string> placeholder;
    in property <string> error;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <length> font-size: 16px;
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited();

    spacing: 6px;
    forward-focus: input;

    Rectangle {
        height: 40px;
        background: Theme.surface-input;
        border-radius: 4px;
        border-width: root.error != "" ? 1px : 0px;
        border-color: Theme.danger;
        opacity: root.enabled ? 1.0 : 0.55;
        clip: true;

        Rectangle {
            x: 12px;
            width: parent.width - 24px;
            clip: true;

            input := TextInput {
                property <length> shift;

                x: min(0px, max(parent.width - self.width, self.shift));
                width: max(parent.width, self.preferred-width + 2px);
                height: parent.height;
                color: Theme.ink;
                font-size: root.font-size;
                single-line: true;
                enabled: root.enabled;
                vertical-alignment: center;
                input-type: root.password ? InputType.password : InputType.text;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
                cursor-position-changed(position) => {
                    if position.x + self.shift < 0px {
                        self.shift = -position.x;
                    } else if position.x + self.shift > parent.width - 2px {
                        self.shift = parent.width - 2px - position.x;
                    }
                }
            }
        }

        Text {
            x: 12px;
            text: root.placeholder;
            visible: input.text == "";
            color: Theme.ink-dim;
            font-size: root.font-size;
            vertical-alignment: center;
        }
    }

    if root.error != "" : Text {
        text: root.error;
        color: Theme.danger;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// Um item do menu de contexto: 32 de altura, 14/500; no hover, `brand` e texto branco (o
// de perigo fica em `danger-fill`).
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <bool> checked;
    in property <bool> checkable;
    in property <bool> submenu;
    callback clicked();

    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? (root.danger ? Theme.danger-fill : Theme.brand) : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            text: root.text;
            color: touch.has-hover ? #ffffff : (root.danger ? Theme.danger : Theme.ink-soft);
            font-size: Theme.button-size;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.checkable : Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            border-width: 1px;
            border-color: touch.has-hover ? #ffffff : Theme.ink-dim;
            background: root.checked ? (touch.has-hover ? #ffffff : Theme.brand) : transparent;

            if root.checked : Glyph {
                commands: Icons.check;
                size: 12px;
                tint: touch.has-hover ? Theme.brand : #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if root.submenu : Glyph {
            commands: Icons.chevron-right;
            size: 14px;
            tint: touch.has-hover ? #ffffff : Theme.ink-dim;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MenuLine inherits Rectangle {
    height: 9px;

    Rectangle {
        y: 4px;
        height: 1px;
        x: 4px;
        width: parent.width - 8px;
        background: Theme.line;
    }
}

// A moldura de todo menu: `surface-float`, raio 8, respiro 6 8, 188 no mínimo, sombra.
export component MenuSheet inherits Rectangle {
    min-width: 188px;
    border-radius: 8px;
    background: Theme.surface-float;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #0000003d;

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        alignment: start;

        @children
    }
}

// A bolinha de status no canto do avatar: 10 com anel de 3 na cor do fundo. Online é o
// círculo cheio; offline, o anel vazado.
export component StatusDot inherits Rectangle {
    in property <bool> online;
    in property <color> ring: Theme.surface-side;

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: root.ring;

    Rectangle {
        width: 10px;
        height: 10px;
        x: 3px;
        y: 3px;
        border-radius: 5px;
        background: root.online ? Theme.online : transparent;
        border-width: root.online ? 0px : 2px;
        border-color: Theme.offline;
    }
}

// O selo "AO VIVO" do Discord: fundo `live`, raio 4, 11/700 branco.
export component LivePill inherits Rectangle {
    callback clicked();
    in property <bool> clickable;

    width: said.preferred-width + 10px;
    height: 16px;
    border-radius: 4px;
    background: Theme.live;

    said := Text {
        text: "AO VIVO";
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}
