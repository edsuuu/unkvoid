import { ScrollView } from "std-widgets.slint";
import { Icons, Skin } from "skin.slint";
import { Ui } from "state.slint";
import { Avatar, Glyph, LabelMono, Muted, RowItem } from "widgets.slint";

// Uma linha da coluna da esquerda.
component Section inherits RowItem {
    in property <string> commands;
    in property <string> text;
    in property <bool> danger;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Glyph {
            commands: root.commands;
            size: 14px;
            tint: root.danger ? Skin.danger : (root.on ? Skin.ink-strong : Skin.ink-icon);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.danger ? Skin.danger : (root.on ? Skin.ink-strong : Skin.ink-icon);
            font-family: Skin.sans;
            font-size: 13px;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// Um dado da conta: o nome à esquerda, o valor à direita.
component Line inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 10px;

    Text {
        text: root.label;
        color: Skin.ink-soft;
        font-family: Skin.sans;
        font-size: 12.5px;
    }

    Rectangle { horizontal-stretch: 1; }

    Text {
        text: root.value;
        color: Skin.ink-body;
        font-family: Skin.sans;
        font-size: 12.5px;
        overflow: elide;
    }
}

// Um aparelho escolhível: a bolinha e o nome.
component Choice inherits RowItem {
    in property <string> label;

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 10px;

        Rectangle {
            width: 9px;
            height: 9px;
            border-radius: 5px;
            background: root.on ? Skin.brand : #ffffff33;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.label;
            color: root.on ? Skin.ink-strong : Skin.ink-icon;
            font-family: Skin.sans;
            font-size: 12.5px;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
// As configurações da conta, no molde do Discord — e o mesmo desenho que o macOS já tem: um
// painel que toma quase a janela toda, as seções agrupadas à esquerda, a seção aberta à
// direita e o "X / ESC" no canto.
//
// Só entram as abas que têm o que mostrar. "Teclas" e "Notificações" existem no Mac porque
// as preferências de voz moram na ABI dele; aqui elas ainda não subiram para o núcleo, e aba
// que não faz nada não entra.
export component SettingsModal inherits Rectangle {
    property <string> tab: "account";
    property <bool> shown;

    background: #06050abd;
    opacity: root.shown ? 1.0 : 0.0;
    init => { root.shown = true; }

    animate opacity { duration: 180ms; easing: ease-out; }

    // Clicar fora fecha, e o Esc também. O painel come o clique dele.
    TouchArea {
        clicked => { Ui.close-settings(); }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                Ui.close-settings();

                return accept;
            }

            return reject;
        }
    }

    // O painel sobe ao aparecer (o `animate-rise` do React) e tem a sombra funda do
    // `.glass-panel`: é ela que o descola do fundo em vez de deixá-lo colado na janela.
    Rectangle {
        x: 24px;
        y: root.shown ? 24px : 34px;
        width: parent.width - 48px;
        height: parent.height - 48px;
        background: #100d1af7;
        border-radius: 22px;
        border-width: 1px;
        border-color: #ffffff1a;
        drop-shadow-blur: 45px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #000000f2;

        animate y { duration: 220ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

        TouchArea { }

        HorizontalLayout {
            // ---- a coluna das seções ----
            Rectangle {
                width: 252px;
                background: #0000002e;
                border-top-left-radius: 20px;
                border-bottom-left-radius: 20px;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 22px;
                    padding-bottom: 22px;
                    spacing: 4px;
                    alignment: start;

                    LabelMono {
                        text: "CONFIGURAÇÕES DE USUÁRIO";
                        // O mesmo respiro do Mac em volta do título de cada grupo.
                        x: 10px;
                    }

                    Section {
                        commands: Icons.users;
                        text: "Minha conta";
                        on: root.tab == "account";
                        clicked => { root.tab = "account"; }
                    }

                    Rectangle { height: 10px; }

                    LabelMono {
                        text: "CONFIGURAÇÕES DO APP";
                        x: 10px;
                    }

                    Section {
                        commands: Icons.mic;
                        text: "Voz e vídeo";
                        on: root.tab == "voice";
                        clicked => { root.tab = "voice"; }
                    }

                    Rectangle { height: 10px; }

                    Rectangle {
                        height: 1px;
                        background: Skin.line;
                    }

                    Rectangle { height: 10px; }

                    Section {
                        commands: Icons.logout;
                        text: "Sair da conta";
                        danger: true;
                        clicked => {
                            Ui.close-settings();
                            Ui.sign-out();
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Skin.line;
            }

            // ---- a seção aberta ----
            ScrollView {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-top: 36px;
                    padding-bottom: 36px;
                    spacing: 20px;
                    alignment: start;

                    Text {
                        text: root.tab == "account" ? "Minha conta" : "Voz e vídeo";
                        color: Skin.ink-strong;
                        font-family: Skin.sans;
                        font-size: 20px;
                        font-weight: 600;
                    }

                    if root.tab == "account" : VerticalLayout {
                        spacing: 8px;

                        LabelMono { text: "FOTO DE PERFIL"; }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            Avatar {
                                letter: Ui.user-initial;
                                size: 56px;
                                mine: true;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                // ponytail: trocar a foto é `POST /api/me/avatar` com um
                                // arquivo, e o seletor de arquivo do Slint ainda não existe
                                // aqui. Teto: a foto se troca pelo site ou pelo Mac.
                                Muted { text: "A foto se troca no site ou no app do Mac."; }
                            }
                        }

                        Rectangle { height: 8px; }

                        LabelMono { text: "CONTA"; }

                        Line {
                            label: "Apelido";
                            value: Ui.user-name;
                        }

                        Line {
                            label: "Entrada";
                            value: Ui.signed-in ? "conta conectada" : "usando sem login";
                        }
                    }

                    if root.tab == "voice" : VerticalLayout {
                        spacing: 8px;

                        LabelMono { text: "MICROFONE"; }

                        if Ui.microphones.length == 0 : Muted {
                            text: "Nenhum aparelho encontrado.";
                        }

                        for device[index] in Ui.microphones : Choice {
                            label: device.label;
                            on: device.current;
                            clicked => { Ui.use-microphone(index); }
                        }

                        Rectangle { height: 8px; }

                        LabelMono { text: "SAÍDA DE ÁUDIO"; }

                        if Ui.speakers.length == 0 : Muted {
                            text: "Nenhum aparelho encontrado.";
                        }

                        for device[index] in Ui.speakers : Choice {
                            label: device.label;
                            on: device.current;
                            clicked => { Ui.use-speaker(index); }
                        }

                        Muted { text: "Vale para a voz das pessoas, o áudio das telas e os sons do app."; }
                    }
                }
            }

            // ---- o "X / ESC" do canto ----
            VerticalLayout {
                padding-top: 36px;
                padding-right: 28px;
                padding-left: 8px;
                spacing: 6px;
                alignment: start;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 1.5px;
                    border-color: close-touch.has-hover ? Skin.ink-strong : Skin.ink-dim;

                    Glyph {
                        commands: Icons.close;
                        size: 14px;
                        tint: close-touch.has-hover ? Skin.ink-strong : Skin.ink-soft;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.close-settings(); }
                    }
                }

                LabelMono {
                    text: "ESC";
                    horizontal-alignment: center;
                }
            }
        }
    }
}

