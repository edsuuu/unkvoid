// A Archivo embutida (OFL, `ui/fonts/`): a mesma letra do React e do site em qualquer sistema.
import "fonts/Archivo.ttf";
import { Skin, Theme } from "skin.slint";
import { Ui } from "state.slint";
import { EntryScreen } from "entry.slint";
import { HubScreen } from "hub.slint";
import { RoomScreen } from "room.slint";
import { Halo, OfflineScreen, Toast, UpdatingScreen } from "shell.slint";
import { NicknameModal, SettingsModal } from "settings.slint";
import { Modals, ServerSettingsModal } from "server.slint";
import { ShareModal } from "share.slint";
import { ClipsScreen, ClipsTray, ClipsUi, OverlayWindow, SectionTabs } from "clips.slint";
import { ResizeEdges, TitleBar } from "frame.slint";

export { Ui, ClipsUi, ClipsTray, OverlayWindow }
export { ClipItem, MonitorItem } from "clips.slint";
export { ActionsRow, AuditRow, BanRow, ChannelRow, DeviceRow, MemberGroupRow, MemberRow, MessageRow, PeerRow, PermissionRow, RoleRow, ServerRow, SourceRow, ToastRow, VoicePersonRow } from "state.slint";

// A janela é a pilha das cinco telas, e quem diz qual está valendo é o núcleo. A moldura é
// nossa (`frame.slint`): sem ela não há onde pôr o botão da atualização ao lado do minimizar.
export component AppWindow inherits Window {
    title: "Unkvoid";
    icon: @image-url("../../desktop/src-tauri/icons/128x128.png");
    no-frame: true;
    // O fundo é o do centro do Discord; a entrada e a sala por código pintam o delas por
    // cima (o halo). A Archivo embutida vale na entrada e na sala por código (`Skin.sans`);
    // o hub do Discord usa a fonte do sistema, como o macOS.
    background: Theme.surface-chat;
    // Os números do `expand_window` do Tauri, que o macOS também usa: com menos largura os
    // cartões da Home quebram em outra ordem.
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 940px;
    min-height: 600px;

    property <length> bar: 32px;

    if Ui.screen != "hub" : Halo { }

    // As telas e os modais moram embaixo da barra: o modal cobre a janela inteira, como o
    // `fixed inset-0` do React, menos a moldura — que continua arrastando e fechando. Logo
    // abaixo da barra ficam as abas Unkvoid e Clips, e os Clips no lugar das telas: com o
    // servidor fora do ar ("Sem conexão", "Atualizando"), o replay e a galeria seguem ao
    // alcance.
    Rectangle {
        y: root.bar;
        height: root.height - root.bar;

        VerticalLayout {
            // Na sala as abas moram na barra dela, à direita da casinha (`room.slint`), e nos
            // Clips na linha do estado e dos botões (`clips.slint`): a faixa só aparece nas
            // outras telas.
            if ClipsUi.available && !ClipsUi.open && Ui.screen != "room" : HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;

                SectionTabs { }
            }

            Rectangle {
                vertical-stretch: 1;

                if !ClipsUi.open && Ui.screen == "entry" : EntryScreen { }
                if !ClipsUi.open && Ui.screen == "hub" : HubScreen { }
                if !ClipsUi.open && Ui.screen == "room" : RoomScreen { }
                if !ClipsUi.open && Ui.screen == "offline" : OfflineScreen { }
                if !ClipsUi.open && Ui.screen == "updating" : UpdatingScreen { }
                if ClipsUi.open : ClipsScreen { }
            }
        }

        if Ui.modal != "" : Modals { }
        if Ui.server-settings-open : ServerSettingsModal { }
        if Ui.settings-open : SettingsModal { }
        if Ui.share-open : ShareModal { }
        if Ui.signed-in && Ui.nickname-pending : NicknameModal { }
    }

    TitleBar {
        y: 0;
        height: root.bar;
    }

    // Os avisos ficam acima de tudo, no pé da janela e no meio, um embaixo do outro.
    if Ui.toasts.length > 0 : VerticalLayout {
        width: min(448px, root.width - 32px);
        // Sem altura própria o bloco ocuparia a janela inteira, e os avisos subiriam ao topo.
        height: self.preferred-height;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 20px;
        spacing: 8px;

        for toast in Ui.toasts : Toast {
            item: toast;
        }
    }

    if !Ui.maximized : ResizeEdges { }
}
