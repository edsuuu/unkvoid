import { Slider } from "std-widgets.slint";
import { Icons, Skin, Theme } from "skin.slint";
import { PeerRow, TileRow, Ui } from "state.slint";
import { Avatar, DButton, Glyph, Label, LivePill, LiveBadge, MenuSheet, Meta, Tip } from "widgets.slint";

// A chamada, no molde do Discord: fundo preto, um cartão 16:9 por pessoa (avatar quando não
// há vídeo) e um por transmissão, vão de 8, raio 8. O foco põe um cartão grande e os outros
// numa faixa de 128 embaixo; a tela cheia deixa um só. Serve ao canal de voz e à sala por
// código: é o mesmo `Stage`.

// Um botão do cartão: 28 de lado, raio 4, chapado.
component TileButton inherits Rectangle {
    in property <string> commands;
    in property <string> hint;
    // "on" é a marca; "off" é o vermelho de algo desligado.
    in property <string> tone: "idle";
    in property <bool> filled;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: root.tone == "on" ? Theme.brand : (root.tone == "off" ? Theme.danger-fill : (touch.has-hover ? Theme.selected : #00000099));

    Glyph {
        commands: root.commands;
        size: 14px;
        filled: root.filled;
        tint: Theme.ink-strong;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if touch.has-hover && root.hint != "" : Tip {
        y: -40px;
        x: min(0px, 28px - self.width);
        text: root.hint;
    }
}

// O rótulo no canto de baixo do cartão: fundo preto a 60%, raio 4, 13/600 branco.
component CardLabel inherits Rectangle {
    in property <string> text;
    in property <bool> muted;

    width: inside.preferred-width + 16px;
    height: 24px;
    border-radius: 4px;
    background: #00000099;

    inside := HorizontalLayout {
        x: 8px;
        spacing: 6px;

        Text {
            text: root.text;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.muted : Glyph {
            commands: Icons.mic-off;
            size: 14px;
            tint: Theme.danger;
            y: (parent.height - self.height) / 2;
        }
    }
}

// Um cartão de pessoa: avatar de 80 no centro, o nome embaixo à esquerda, contorno interno
// verde enquanto fala.
component PersonCard inherits Rectangle {
    in property <PeerRow> peer;
    in property <bool> small;

    border-radius: 8px;
    background: Theme.surface-tile;
    clip: true;

    Avatar {
        letter: root.peer.initial;
        size: root.small ? 48px : 80px;
        mine: root.peer.mine;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.online;
        opacity: root.peer.speaking ? 1.0 : 0.0;

        animate opacity { duration: 120ms; easing: ease-out; }
    }

    if !root.small : CardLabel {
        x: 8px;
        y: parent.height - self.height - 8px;
        text: root.peer.reconnecting ? root.peer.name + " · voltando" : root.peer.name;
        muted: root.peer.muted;
    }
}

// `StreamTile`: a tela ou a câmera de alguém, com o selo, o nome e os botões por cima.
component StreamTile inherits Rectangle {
    in property <TileRow> tile;
    in property <bool> thumb;
    property <bool> adjusting;

    border-radius: 8px;
    clip: true;
    background: Theme.surface-tile;

    if root.tile.has-frame : Image {
        source: root.tile.frame;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }

    // Até o primeiro quadro, o cartão diz que a tela está abrindo.
    if !root.tile.has-frame && !root.tile.paused : Meta {
        text: "abrindo…";
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if root.tile.paused : Rectangle {
        background: #00000099;

        Meta {
            text: "pausado";
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    Rectangle {
        border-radius: 8px;
        border-width: root.tile.focused ? 2px : 0px;
        border-color: Theme.brand;
    }

    touch := TouchArea {
        mouse-cursor: root.thumb ? pointer : default;
        clicked => {
            if root.thumb {
                Ui.toggle-focus(root.tile.producer);
            }
        }
        double-clicked => {
            if !root.thumb {
                Ui.toggle-focus(root.tile.producer);
            }
        }
    }

    if !root.thumb : Rectangle {
        x: 8px;
        y: 8px;
        width: badge.preferred-width + 10px;
        height: 16px;
        border-radius: 4px;
        background: root.tile.camera || root.tile.mine ? Theme.brand : Theme.live;

        badge := Text {
            text: root.tile.camera ? "CÂMERA" : (root.tile.mine ? "VOCÊ" : "AO VIVO");
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if !root.thumb : HorizontalLayout {
        x: 8px;
        y: parent.height - 24px - 8px;
        height: 24px;
        spacing: 6px;
        alignment: start;

        CardLabel {
            text: root.tile.label;
        }

        if root.tile.stats != "" && !root.tile.camera : Rectangle {
            width: stats.preferred-width + 12px;
            border-radius: 4px;
            background: #00000099;

            stats := Text {
                text: root.tile.paused ? "pausado" : root.tile.stats;
                color: root.tile.loss-high && !root.tile.paused ? Theme.danger : Theme.ink-dim;
                font-family: Skin.mono;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.tile.watchers > 0 : Rectangle {
            width: eyes.preferred-width + 12px;
            border-radius: 4px;
            background: #00000099;

            eyes := HorizontalLayout {
                x: 6px;
                spacing: 4px;

                Glyph {
                    commands: Icons.eye;
                    size: 12px;
                    tint: Theme.ink-soft;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.tile.watchers;
                    color: Theme.ink-soft;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            watchers := TouchArea { }

            if watchers.has-hover && root.tile.watcher-names != "" : Tip {
                text: root.tile.watcher-names;
                y: -40px;
            }
        }
    }

    // Os botões no hover, no canto de cima à direita: volume, pausar, focar, tela cheia,
    // fechar.
    if !root.thumb && (touch.has-hover || root.adjusting) : HorizontalLayout {
        x: parent.width - self.preferred-width - 8px;
        y: 8px;
        height: 28px;
        spacing: 4px;

        if root.tile.audio : TileButton {
            commands: root.tile.heard ? Icons.speaker : Icons.speaker-off;
            tone: root.tile.heard ? "idle" : "off";
            hint: root.tile.heard ? "Mutar o áudio desta tela" : "Ativar o áudio desta tela";
            clicked => { Ui.toggle-heard(root.tile.producer); }
        }

        if root.tile.audio : TileButton {
            commands: Icons.sliders;
            tone: root.adjusting ? "on" : "idle";
            hint: "Volume";
            clicked => { root.adjusting = !root.adjusting; }
        }

        if !root.tile.mine : TileButton {
            commands: root.tile.paused ? Icons.play : Icons.pause;
            filled: root.tile.paused;
            hint: root.tile.paused ? "Retomar" : "Pausar";
            clicked => { Ui.pause-tile(root.tile.producer); }
        }

        TileButton {
            commands: Icons.focus;
            tone: root.tile.focused ? "on" : "idle";
            hint: root.tile.focused ? "Sair do foco" : "Focar";
            clicked => { Ui.toggle-focus(root.tile.producer); }
        }

        TileButton {
            commands: root.tile.full ? Icons.fullscreen-exit : Icons.fullscreen;
            hint: root.tile.full ? "Sair da tela cheia" : "Tela cheia";
            clicked => { Ui.toggle-fullscreen(root.tile.producer); }
        }

        TileButton {
            commands: Icons.close;
            hint: root.tile.mine ? "Ocultar minha tela" : "Fechar (continua ao vivo para os outros)";
            clicked => {
                if root.tile.mine {
                    Ui.toggle-self-view();
                } else {
                    Ui.close-tile(root.tile.producer);
                }
            }
        }
    }

    // ponytail: sem os filtros de imagem do React. Teto: a imagem sai como o decodificador
    // a entregou. A saída é aplicar a conta no RGB da conversão.
    if root.adjusting && !root.thumb : MenuSheet {
        x: parent.width - self.width - 8px;
        y: 44px;
        width: 220px;

        Label {
            text: root.tile.heard ? "VOLUME " + root.tile.volume + "%" : "VOLUME (MUDO)";
            x: 8px;
            height: 20px;
            vertical-alignment: center;
        }

        // O volume de verdade, e zero com o som desligado: arrastar liga.
        Slider {
            minimum: 0;
            maximum: 100;
            value: root.tile.heard ? root.tile.volume : 0;
            changed(level) => { Ui.set-volume(root.tile.producer, level); }
        }
    }
}

// O cartão de uma transmissão que ainda não se abriu: escurecido, com o botão.
component PendingCard inherits Rectangle {
    border-radius: 8px;
    background: Theme.surface-tile;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Glyph {
            commands: Icons.screen;
            size: 32px;
            tint: Theme.ink-dim;
            x: (parent.width - self.width) / 2;
        }

        HorizontalLayout {
            alignment: center;

            DButton {
                text: Ui.pending-tiles == 1 ? "Assistir transmissão" : "Assistir " + Ui.pending-tiles + " transmissões";
                kind: "secondary";
                width: 200px;
                clicked => { Ui.watch-pending(); }
            }
        }
    }
}

// `PeopleMenu`: a pílula com até três rostos e a contagem, que abre quem está na sala. A
// sala por código a usa na barra.
export component PeopleMenu inherits Rectangle {
    property <int> shown: min(3, max(1, Ui.peers.length));
    property <length> faces-width: shown * 26px + (shown - 1) * 5px;

    width: 6px + faces-width + 46px;
    height: 32px;
    border-radius: 999px;
    border-width: 1px;
    border-color: touch.has-hover ? #8a7cf580 : Skin.line-strong;
    background: Skin.row;

    HorizontalLayout {
        x: 6px;
        width: root.faces-width;
        height: parent.height;
        spacing: 5px;
        alignment: start;

        for peer[index] in Ui.peers : Rectangle {
            width: index < 3 ? 26px : 0px;
            visible: index < 3;

            Avatar {
                letter: peer.initial;
                size: 26px;
                mine: peer.mine;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    Text {
        x: 6px + root.faces-width + 8px;
        text: Ui.peers.length == 0 ? "1" : Ui.peers.length;
        color: Skin.ink-dim;
        font-family: Skin.mono;
        font-size: 10.5px;
        vertical-alignment: center;
        height: parent.height;
    }

    Glyph {
        x: parent.width - 20px;
        y: (parent.height - self.height) / 2;
        commands: Icons.chevron-down;
        size: 12px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { list.show(); }
    }

    list := PopupWindow {
        x: 0px;
        y: parent.height + 6px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        MenuSheet {
            width: 300px;

            Label { text: "NA SALA"; x: 8px; height: 24px; vertical-alignment: center; }

            for peer in Ui.peers : Rectangle {
                height: 40px;
                border-radius: 4px;
                background: peer.mine ? #23A55A1a : transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;

                    Avatar {
                        letter: peer.initial;
                        size: 24px;
                        mine: peer.mine;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: peer.name;
                        color: peer.reconnecting ? Theme.ink-dim : Theme.ink;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    if peer.muted : Glyph {
                        commands: Icons.mic-off;
                        size: 14px;
                        tint: Theme.danger;
                        y: (parent.height - self.height) / 2;
                    }

                    if peer.sharing : LivePill {
                        y: (parent.height - self.height) / 2;
                    }

                    Meta {
                        text: peer.mine ? "você" : (peer.reconnecting ? "parado" : Ui.ping);
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component Stage inherits Rectangle {
    // O código da sala, para a frase quando não há ninguém. No canal de voz fica vazio.
    in property <string> code;

    // As cartas: as pessoas, as transmissões e, se houver, uma para as que faltam abrir.
    property <int> waiting: Ui.pending-tiles > 0 ? 1 : 0;
    property <int> cards: Ui.peers.length + Ui.tiles.length + root.waiting;
    property <int> columns: max(1, Math.ceil(Math.sqrt(root.cards)));
    property <int> lines: max(1, Math.ceil(root.cards / root.columns));
    property <length> gap: 8px;
    property <length> cell-width: (root.width - 16px - (root.columns - 1) * root.gap) / root.columns;
    property <length> cell-height: (root.height - 16px - (root.lines - 1) * root.gap) / root.lines;
    // O cartão é 16:9 dentro da célula, e a grade inteira fica no centro.
    property <length> card-width: min(root.cell-width, root.cell-height * 16 / 9);
    property <length> card-height: root.card-width * 9 / 16;
    property <length> left: (root.width - root.columns * root.card-width - (root.columns - 1) * root.gap) / 2;
    property <length> top: (root.height - root.lines * root.card-height - (root.lines - 1) * root.gap) / 2;
    // No foco: o grande em cima, a faixa de 128 embaixo com cartões de 228 (16:9).
    property <length> strip: 128px;
    property <length> thumb-width: root.strip * 16 / 9;
    property <length> big-height: root.height - 16px - root.strip - root.gap;

    background: Theme.surface-call;

    if root.cards == 0 : VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            text: "Ninguém por aqui ainda.";
            color: Theme.ink-strong;
            font-size: Theme.title-size;
            font-weight: 700;
            horizontal-alignment: center;
        }

        if root.code != "" : Text {
            text: "Mande o código " + root.code + " para quem você quer aqui.";
            color: Theme.ink-dim;
            font-size: 14px;
            horizontal-alignment: center;
        }

        if root.code == "" && Ui.can-invite : HorizontalLayout {
            alignment: center;

            DButton {
                text: "Convidar pessoas";
                width: 160px;
                clicked => { Ui.open-modal("invite", -1); }
            }
        }
    }

    // ---- as pessoas ----
    for peer[index] in Ui.peers : PersonCard {
        peer: peer;
        small: Ui.focusing;
        visible: !Ui.full-screen;
        x: Ui.focusing ? 8px + index * (root.thumb-width + root.gap) : root.left + Math.mod(index, root.columns) * (root.card-width + root.gap);
        y: Ui.focusing ? root.height - 8px - root.strip : root.top + Math.floor(index / root.columns) * (root.card-height + root.gap);
        width: Ui.focusing ? root.thumb-width : root.card-width;
        height: Ui.focusing ? root.strip : root.card-height;
    }

    // ---- as transmissões ----
    for tile in Ui.tiles : StreamTile {
        property <int> slot: Ui.peers.length + tile.rank;
        property <int> place: Ui.peers.length + tile.rank;

        tile: tile;
        thumb: Ui.focusing && !tile.focused;
        visible: !Ui.full-screen || tile.full;
        x: Ui.full-screen || (Ui.focusing && tile.focused)
            ? (Ui.full-screen ? 0px : 8px)
            : (Ui.focusing ? 8px + self.slot * (root.thumb-width + root.gap) : root.left + Math.mod(self.place, root.columns) * (root.card-width + root.gap));
        y: Ui.full-screen
            ? 0px
            : (Ui.focusing ? (tile.focused ? 8px : root.height - 8px - root.strip) : root.top + Math.floor(self.place / root.columns) * (root.card-height + root.gap));
        width: Ui.full-screen ? root.width : (Ui.focusing ? (tile.focused ? root.width - 16px : root.thumb-width) : root.card-width);
        height: Ui.full-screen ? root.height : (Ui.focusing ? (tile.focused ? root.big-height : root.strip) : root.card-height);
    }

    if root.waiting == 1 && !Ui.full-screen : PendingCard {
        property <int> place: Ui.peers.length + Ui.tiles.length;

        x: Ui.focusing ? 8px + self.place * (root.thumb-width + root.gap) : root.left + Math.mod(self.place, root.columns) * (root.card-width + root.gap);
        y: Ui.focusing ? root.height - 8px - root.strip : root.top + Math.floor(self.place / root.columns) * (root.card-height + root.gap);
        width: Ui.focusing ? root.thumb-width : root.card-width;
        height: Ui.focusing ? root.strip : root.card-height;
    }

    if Ui.reconnecting : Rectangle {
        x: (parent.width - self.width) / 2;
        y: 8px;
        width: said.preferred-width + 24px;
        height: 28px;
        border-radius: 4px;
        background: Theme.idle;

        said := Text {
            text: "Reconectando…";
            color: #000000;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // O Esc sai do foco e da tela cheia; o espaço segurado é o "apertar para falar"
    // enquanto a chamada está em foco (a tecla global é plataforma, e vem depois).
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && (Ui.focusing || Ui.full-screen) {
                if Ui.full-screen {
                    Ui.toggle-fullscreen("");
                } else {
                    Ui.toggle-focus("");
                }

                return accept;
            }

            if event.text == " " && !event.repeat {
                Ui.talk(true);

                return accept;
            }

            return reject;
        }
        key-released(event) => {
            if event.text == " " {
                Ui.talk(false);

                return accept;
            }

            return reject;
        }
    }
}
