// O que a janela desenha, e o caminho de volta para o núcleo.
//
// Nada aqui decide: o que é um código de sala válido, quem pode falar, o que é um servidor
// e onde se cai ao sair é do `shared/core`. Este arquivo é só o formato em que o que ele
// respondeu chega à tela, e o nome de cada clique.
export struct ServerRow {
    name: string,
    initial: string,
    current: bool,
    /// "dono" ou "membro" — quem decide é o núcleo, comparando o dono com quem está logado.
    note: string,
    /// A data do último acesso, já escrita em pt-BR. Vazia quando nunca se entrou.
    at: string,
}

/// O que eu posso fazer com uma pessoa, decidido pelo núcleo (`member_actions`) na ordem
/// do Discord: hierarquia e bits. A tela só esconde item de menu.
export struct ActionsRow {
    mute: bool,
    disconnect: bool,
    kick: bool,
    ban: bool,
    /// Mutada pelo servidor: o microfone cortado fica vermelho.
    server-muted: bool,
}

/// Quem está num canal de voz em que você não está, pelo que o Laravel sabe.
export struct VoicePersonRow {
    user-id: int,
    name: string,
    initial: string,
    mine: bool,
    muted: bool,
    camera: bool,
    live: bool,
    actions: ActionsRow,
}

export struct ChannelRow {
    /// A posição na lista inteira do servidor: é ela que volta em `open-channel`, porque a
    /// tela mostra texto e voz em duas colunas mas o núcleo só conhece uma.
    index: int,
    /// O identificador do canal, que é o que diz se a voz aberta é esta.
    id: string,
    name: string,
    topic: string,
    /// O limite de pessoas na voz; zero é sem limite.
    limit: int,
    voice: bool,
    current: bool,
    people: [VoicePersonRow],
    /// Mover alguém daqui pede MOVE_MEMBERS neste canal; mover para cá pede MOVE_MEMBERS e
    /// CONNECT aqui. O Laravel decide de verdade; a tela só esconde o item.
    can-move-from: bool,
    can-move-here: bool,
}

export struct MemberRow {
    user-id: int,
    name: string,
    initial: string,
    owner: bool,
    mine: bool,
    /// "Na voz: Reunião", "Transmitindo", ou nada.
    note: string,
    actions: ActionsRow,
}

/// Um grupo da lista de membros, como o Discord: o cargo mais alto de quem está online, e os
/// offline no fim. `colored` diz se o cargo tem cor.
export struct MemberGroupRow {
    label: string,
    color: color,
    colored: bool,
    offline: bool,
    members: [MemberRow],
}

/// Um cargo na tela de configuração, com o que o núcleo diz que dá para fazer nele.
export struct RoleRow {
    id: int,
    name: string,
    color: color,
    colored: bool,
    everyone: bool,
    editable: bool,
}

/// Um bit de permissão do cargo escolhido.
export struct PermissionRow {
    bit: int,
    label: string,
    on: bool,
}

export struct BanRow {
    user-id: int,
    name: string,
    reason: string,
}

export struct AuditRow {
    at: string,
    text: string,
}

/// Uma tela ou um aplicativo do seletor. `value` é `display:<id>` ou `window:<id>`, o que o
/// núcleo lê no `capture_config`.
export struct SourceRow {
    value: string,
    label: string,
    detail: string,
    preview: image,
    has-preview: bool,
}

/// Um aviso no pé da janela. `error` pinta de vermelho.
export struct ToastRow {
    id: int,
    text: string,
    error: bool,
}

export struct MessageRow {
    /// O identificador da mensagem, que é o que volta em editar e apagar. Zero quando a
    /// linha não veio do servidor.
    id: int,
    author: string,
    initial: string,
    body: string,
    at: string,
    /// Se é sua: só a sua se edita, e o "⋯" só aparece nela.
    mine: bool,
    /// Continuação da anterior (mesma pessoa, pouco depois): sem avatar nem nome.
    continued: bool,
    /// A cor do cargo mais alto de quem escreveu.
    color: color,
    colored: bool,
}

export struct PeerRow {
    user-id: int,
    name: string,
    initial: string,
    note: string,
    mine: bool,
    /// Falando agora: o anel verde em volta do rosto.
    speaking: bool,
    /// Com o microfone desenhado como desligado.
    muted: bool,
    /// Transmitindo a tela: o selo "AO VIVO".
    sharing: bool,
    camera: bool,
    /// Caiu e está na carência: o nome apaga e a latência vira "parado".
    reconnecting: bool,
    /// Calada só para mim, pelo menu.
    local-muted: bool,
    actions: ActionsRow,
}

/// Uma transmissão que se está assistindo: um cartão da chamada.
export struct TileRow {
    /// O producer do vídeo: é ele que volta nos cliques do cartão.
    producer: string,
    label: string,
    initial: string,
    /// "Ver o que a sala vê": a própria tela.
    mine: bool,
    camera: bool,
    paused: bool,
    /// Há som de tela para ligar, e se ele está ligado.
    audio: bool,
    heard: bool,
    /// De 0 a 100, só deste lado.
    volume: int,
    /// Quantos assistem, e quem, para o balão do olho.
    watchers: int,
    watcher-names: string,
    /// `1080p · 60 fps · 0,0%`, e se a perda passou de 2% — aí o número fica vermelho.
    stats: string,
    loss-high: bool,
    /// O último quadro. Até o primeiro chegar, o cartão mostra que está abrindo.
    frame: image,
    has-frame: bool,
    /// O foco põe um cartão grande e os outros na faixa de baixo pela ordem (`rank`); a
    /// tela cheia deixa um só.
    rank: int,
    focused: bool,
    full: bool,
}

export struct DeviceRow {
    label: string,
    current: bool,
}

/// Uma conversa direta na coluna: com quem, a última frase e quantas faltam ler.
export struct ConversationRow {
    user-id: int,
    name: string,
    initial: string,
    last: string,
    unread: int,
}

/// Uma amizade. `state` já vem decidido pelo Rust — a tela não calcula quem pediu a quem.
export struct FriendRow {
    id: int,
    user-id: int,
    name: string,
    initial: string,
    // "accepted", "incoming", "waiting" ou "blocked".
    state: string,
}

export global Ui {
    // Qual das cinco telas está valendo. Quem escolhe é o núcleo.
    in property <string> screen: "updating";
    in property <string> status: "Abrindo o Unkvoid";
    // Quanto da atualização já desceu, de 0 a 100; negativo enquanto não há barra.
    in property <float> update-progress: -1;
    // A versão nova já baixada e conferida, esperando o clique no botão verde da barra.
    in property <bool> update-ready;
    in property <string> update-version;

    // A moldura: a janela não tem a do Windows, e a barra de cima é nossa.
    in property <bool> maximized;
    callback drag-window();
    // "n", "s", "e", "w", "ne", "nw", "se" ou "sw": a borda que se puxa.
    callback resize-window(string);
    callback minimize-window();
    callback toggle-maximize();
    callback close-window();
    callback install-update();
    // A volta para onde se estava antes da atualização, já na thread da janela.
    callback resume-session();

    in property <string> user-name;
    in property <string> user-initial;
    in property <bool> signed-in;

    in property <string> saved-name;
    // A última coisa que deu errado, na frase que a pessoa lê. É uma só porque só há uma
    // tela por vez: a Entry, o Hub e a Room mostram a mesma linha.
    in property <string> complaint;
    in property <bool> entry-busy;

    in property <string> login-error;
    /// A recusa do apelido novo, embaixo do campo dele em "Minha conta". Digitar apaga.
    in-out property <string> nickname-error;
    in property <bool> nickname-busy;
    /// A conta ainda está com o apelido automático: o modal que não fecha pede a escolha.
    in property <bool> nickname-pending;
    in property <string> login-email-error;
    in property <string> login-password-error;
    in property <bool> login-busy;

    in property <string> server-name: "Servidores";
    in property <string> channel-name;
    in property <string> channel-topic;
    in property <[ServerRow]> servers;
    in property <[ChannelRow]> text-channels;
    in property <[ChannelRow]> voice-channels;
    in property <[MemberGroupRow]> member-groups;
    in property <[ToastRow]> toasts;
    // Mensagens de outras pessoas no chat da voz enquanto ele está fechado.
    in property <int> voice-chat-unread;
    in property <[MessageRow]> messages;
    /// O convite do servidor aberto. Só quem pode convidar recebe.
    in property <string> invite-code;
    /// A Home ou o servidor aberto: as duas nunca aparecem juntas.
    in property <bool> in-server;
    /// "servers", "friends" ou "direct" — os três miolos da Home.
    in-out property <string> home-tab: "servers";
    in property <[ConversationRow]> conversations;
    in property <[FriendRow]> friends;
    /// Quantos pedidos de amizade chegaram e esperam resposta.
    in property <int> pending-count;
    /// A conversa aberta.
    in property <string> talking-name;
    in property <[MessageRow]> direct-messages;
    /// As últimas salas por código, já quebradas em linhas: o Slint não embrulha sozinho,
    /// e no React elas são pastilhas que descem de linha quando não cabem.
    in property <[[string]]> recent-rooms;

    /// O que eu posso no servidor aberto, pelos bits que o núcleo conferiu.
    in property <bool> is-owner;
    in property <bool> can-manage-server;
    in property <bool> can-manage-channels;
    in property <bool> can-manage-roles;
    in property <bool> can-invite;
    in property <bool> can-ban;
    in property <bool> can-audit;

    /// A lista de membros à direita. Abaixo de 1100 de largura ela começa fechada.
    in-out property <bool> members-open: true;

    /// O canal de voz em que se está, e o nome dele. Vazio quer dizer fora da voz — e é
    /// dentro do hub que isso aparece, como no Discord: não se troca de tela para falar.
    in property <string> voice-channel;
    in property <string> voice-name;
    /// "connecting", "connected", "reconnecting"; vazio fora da voz.
    in property <string> voice-state;
    /// A chamada no lugar do chat.
    in-out property <bool> stage-open;
    /// O chat do canal de voz, a gaveta à direita da chamada.
    in-out property <bool> voice-chat-open;
    in property <[MessageRow]> voice-messages;

    in property <string> room-code;
    in property <[PeerRow]> peers;
    in property <bool> sharing;
    /// A própria câmera no ar, e se este sistema sabe ligá-la aqui (o Linux, dentro da voz).
    in property <bool> camera-on;
    in property <bool> camera-available;
    // O ida e volta até o SFU, medido no batimento do núcleo. Até o primeiro voltar é um
    // traço, que é o que o app em React mostra nesse intervalo.
    in property <string> ping: "-- ms";
    /// O mesmo número, para a cor do sinal decidir sozinha. Negativo é "ainda medindo".
    in property <int> ping-ms: -1;
    /// Quantas barrinhas o núcleo contou (0 a 4).
    in property <int> ping-bars: 0;
    in property <string> elapsed: "0:00:00";

    in property <bool> mic-on;
    in property <bool> can-speak: true;
    in property <bool> deafened;
    /// Eu falando agora: o anel verde na barra de baixo.
    in property <bool> speaking;
    /// O nível do próprio microfone, de 0 a 1: o medidor da sensibilidade.
    in property <float> mic-level;

    /// As telas que se está assistindo, uma por cartão, e quantas estão ao vivo sem estar
    /// abertas — é o que acende o "Assistir transmissão".
    in property <[TileRow]> tiles;
    in property <int> pending-tiles;
    /// Um cartão está no foco (os outros na faixa) ou em tela cheia. Só do lado de quem olha.
    in property <bool> focusing;
    in property <bool> full-screen;
    in property <bool> can-share: true;
    in property <bool> reconnecting;
    /// "Ver o que a sala vê": a própria tela aberta no palco.
    in property <bool> self-view;

    /// As configurações da conta: o modal do Discord, por cima de tudo.
    in-out property <bool> settings-open;
    // A seção aberta nas Configurações: "account", "voice" ou "clips". Fica aqui, e não no
    // modal, para a engrenagem dos Clips abrir direto na seção deles.
    in-out property <string> settings-tab: "account";
    in property <[DeviceRow]> microphones;
    in property <[DeviceRow]> speakers;
    /// Voz e vídeo: "open", "voice" ou "ptt"; a sensibilidade de 0 a 100; e as marcas.
    in property <string> input-mode: "open";
    in property <int> sensitivity: 35;
    in property <bool> mute-on-join;
    in property <bool> echo-cancel: true;
    in property <bool> noise-suppress: true;
    in property <bool> auto-gain: true;

    /// O modal aberto: "", "server-new", "server-join", "channel-new", "invite",
    /// "channel-edit" ou "confirm". Um por vez, como no Discord.
    in-out property <string> modal;
    /// O canal que o "Editar canal" mostra, e o que o "Criar canal" já vem marcando.
    in property <int> modal-channel-index: -1;
    in-out property <string> modal-channel-name;
    in-out property <string> modal-channel-topic;
    in-out property <int> modal-channel-limit;
    in-out property <bool> modal-channel-voice;
    /// O "tem certeza?": título, frase e o botão vermelho. O que ele faz, a ponte guardou.
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-button;

    /// As configurações do servidor: a tela cheia com a barra lateral.
    in-out property <bool> server-settings-open;
    in-out property <string> server-settings-tab: "overview";
    in property <[RoleRow]> roles;
    in-out property <int> selected-role: -1;
    in property <[PermissionRow]> role-permissions;
    in property <[BanRow]> bans;
    in property <[AuditRow]> audits;

    callback create-room(string, string);
    callback join-room(string, string);
    callback sign-in(string, string, bool);
    callback google-sign-in();
    callback sign-out();
    callback clear-login-error(string);
    callback rename(string);

    callback show-entry();
    callback show-home();

    callback open-server(int);
    callback open-channel(int);
    /// O nome e se é de voz. Quem não pode criar canal recebe a recusa do Laravel.
    callback create-channel(string, bool);
    /// O índice do canal, o nome, o tópico e o limite (zero é sem limite).
    callback update-channel(int, string, string, int);
    callback send-message(string);
    callback edit-message(int, string);
    callback delete-message(int);
    callback create-server(string);
    callback join-invite(string);
    callback rename-server(string);
    callback regenerate-invite();
    /// Volta para a Home e recarrega o que ela mostra.
    callback show-hub-home();
    callback load-friends();
    callback add-friend(string);
    callback answer-friend(int, bool);
    /// O índice da conversa na coluna, não o identificador da pessoa.
    callback open-conversation(int);
    callback send-direct(string);
    /// O índice do amigo na lista: abre a conversa com ele.
    callback talk-to-friend(int);
    callback open-recent-room(string);

    /// Abre um modal; os que editam um canal recebem o índice dele.
    callback open-modal(string, int);
    /// Pede confirmação antes de algo que não volta: "delete-channel", "delete-server",
    /// "leave-server", "kick", "ban" — com o id do canal (índice) ou da pessoa.
    callback ask(string, int);
    callback confirm();

    /// As configurações do servidor: abrir numa aba, escolher um cargo, mexer nele.
    callback open-server-settings(string);
    callback select-role(int);
    callback create-role(string);
    callback delete-role(int);
    callback toggle-permission(int);
    callback unban(int);
    /// Moderação de uma pessoa, pelo id de usuário.
    callback server-mute(int, bool);
    callback disconnect-voice(int);
    /// Move a pessoa para o canal de voz no índice dado.
    callback move-voice(int, int);
    /// Abre a conversa direta com a pessoa (id e nome).
    callback message-user(int, string);
    /// Cala uma pessoa da voz só para mim.
    callback mute-person(int, bool);

    callback leave-room();
    callback leave-voice();
    /// A casinha da sala: vai para a Home com a sala viva — quem transmite continua
    /// transmitindo. `back-to-room` é o caminho de volta, pela trilha da Home.
    callback visit-home();
    callback back-to-room();
    /// O servidor tirou esta sessão da sala: "replaced" ou "kicked".
    callback thrown-out(string);
    /// Abre ou fecha o chat do canal de voz; abrir relê as mensagens dele.
    callback toggle-voice-chat();
    callback dismiss-toast(int);

    // O seletor de tela: o que ele lista, o que está escolhido e com que qualidade.
    in-out property <bool> share-open;
    in property <bool> share-loading;
    in property <string> share-tab: "display";
    in property <[SourceRow]> share-displays;
    in property <[SourceRow]> share-windows;
    in-out property <string> share-source;
    in-out property <string> share-quality: "1080";
    in-out property <string> share-fps: "60";
    in-out property <bool> share-audio: true;
    in-out property <bool> share-mute-calls: true;
    /// O botão da tela: abre o seletor — ou, no ar, o seletor de trocar a transmissão.
    callback open-share();
    callback pick-share-tab(string);
    callback confirm-share();
    /// A sessão acabou sozinha (o token não renovou): a janela volta ao login.
    callback session-ended();
    /// Um evento do tempo real, entregue na thread da janela: é por aqui que ele chega à ponte.
    callback heard-live(string);
    callback send-voice-message(string);
    callback toggle-share();
    callback toggle-camera();

    callback watch-pending();
    callback toggle-self-view();
    callback close-tile(string);
    callback pause-tile(string);
    callback toggle-heard(string);
    callback toggle-focus(string);
    callback toggle-fullscreen(string);
    /// De 0 a 100, só do lado de quem ouve. Mexer nele liga o som da tela, e zero desliga.
    callback set-volume(string, float);
    /// O volume de uma pessoa da voz (pelo id de usuário), de 0 a 2.
    callback set-person-volume(int, float);

    callback toggle-mic();
    callback toggle-deafen();
    /// A tecla de apertar para falar desceu ou subiu.
    callback talk(bool);
    // A lista é pedida na hora de abrir o popover: aparelho ligado depois que o app abriu
    // tem de aparecer sem reiniciar nada.
    callback list-microphones();
    callback list-speakers();
    callback open-settings();
    callback close-settings();
    callback use-microphone(int);
    callback use-speaker(int);
    /// "open", "voice" ou "ptt", e a sensibilidade.
    callback set-input-mode(string, int);
    /// Uma marca de Voz e vídeo: "muteOnJoin", "echoCancel", "noiseSuppress", "autoGain".
    callback set-voice-flag(string, bool);
}
