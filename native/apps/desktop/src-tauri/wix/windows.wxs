<?xml version="1.0" encoding="UTF-8"?>
<!--
  O que o instalador do Tauri NÃO faz: liberar o app no firewall.

  O Windows bloqueia conexão de ENTRADA por padrão, e o WebRTC precisa receber para o
  ICE fechar — sem isso a transmissão direta entre duas máquinas não conecta, e o
  usuário leva um popup do firewall no meio da chamada. Sair não precisa de permissão,
  então o caminho pelo SFU funciona de qualquer jeito; é o P2P que depende disto.

  O atalho na área de trabalho NÃO está aqui: o template do Tauri já cria
  (`ApplicationDesktopShortcut`, em `ShortcutsFeature`). Declarar `DesktopFolder` de
  novo duplica o símbolo e o `light` falha — foi o que derrubou o build da v0.8.0.

  `Return="ignore"`: se o netsh falhar, a instalação continua e o pior caso é o popup
  que já existia. Instalação que quebra por causa de regra de rede seria pior.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <DirectoryRef Id="INSTALLDIR">
            <!-- Componente só para ancorar o fragmento: um fragmento sem nada
                 referenciado não é linkado. A chave também registra que a regra foi
                 criada, e some na desinstalação junto com ela. -->
            <Component Id="FirewallMarker" Guid="6E2B6A17-0F4C-4D3E-9C21-58B0F3A7D411">
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Unkvoid"
                    Name="FirewallRule"
                    Type="string"
                    Value="[ProductName]"
                    KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <ComponentGroup Id="FirewallGroup">
            <ComponentRef Id="FirewallMarker" />
        </ComponentGroup>

        <!-- Tipo 34 (diretório + linha de comando): o Target é resolvido quando a ação
             entra no script, então [INSTALLDIR] e [ProductName] valem mesmo em deferred.
             Impersonate="no" porque mexer no firewall exige privilégio. -->
        <CustomAction
            Id="UnkvoidFirewallAdd"
            Directory="INSTALLDIR"
            ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=&quot;[ProductName]&quot; dir=in action=allow program=&quot;[INSTALLDIR][ProductName].exe&quot; enable=yes profile=private,domain"
            Execute="deferred"
            Impersonate="no"
            Return="ignore" />

        <CustomAction
            Id="UnkvoidFirewallRemove"
            Directory="INSTALLDIR"
            ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;[ProductName]&quot;"
            Execute="deferred"
            Impersonate="no"
            Return="ignore" />

        <InstallExecuteSequence>
            <Custom Action="UnkvoidFirewallAdd" After="InstallFiles">NOT Installed</Custom>
            <Custom Action="UnkvoidFirewallRemove" Before="RemoveFiles">Installed AND NOT UPGRADINGPRODUCTCODE</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
