{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unkvoid",
  "version": "0.6.0",
  "identifier": "com.unkvoid.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unkvoid",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "deb",
      "dmg",
      "app",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Voice, video, and screen sharing",
    "longDescription": "Unkvoid: desktop client with native screen capture, no browser bar, and system audio.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "wix": {
        "language": "pt-BR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMkFFRDNFNEI5QzgwQTQKUldTa2dKeExQdTBxSGFyYjJLazd1RmNvWFFCdDY5cUYvZmt6MXY2M0ZCb3F2RXorL0U2enowRTYK",
      "endpoints": [
        "https://github.com/edsuuu/unkvoid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "discord2"
        ]
      }
    }
  }
}
