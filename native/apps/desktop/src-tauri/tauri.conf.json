{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unkvoid",
  "version": "0.0.39",
  "identifier": "com.unkvoid.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unkvoid",
        "width": 420,
        "height": 260,
        "resizable": true,
        "label": "main",
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "dmg",
      "app",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Unkvoid",
    "copyright": "Unkvoid - contato@unkvoid.com",
    "homepage": "https://unkvoid.com",
    "category": "SocialNetworking",
    "shortDescription": "Compartilhar a tela sem perder fps",
    "longDescription": "Unkvoid: um nome, um codigo de sala, e a tela. Captura nativa, encoder da placa de video, sem barra de navegador.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.38)",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-nice",
          "gstreamer1.0-x264 | gstreamer1.0-plugins-ugly",
          "gstreamer1.0-tools",
          "gstreamer1.0-pipewire",
          "gstreamer1.0-pulseaudio | gstreamer1.0-plugins-good",
          "x11-xserver-utils"
        ]
      }
    },
    "windows": {
      "wix": {
        "language": "pt-BR"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "unkvoid"
        ]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QkY1M0UyNEM5MTg5QQpSV1NhR01ra1B2V2JDSzhaSUJRR3Ezak1nYlNBWEh0NWZkWXRBTlJqdUQyaVNoVXh0b2RBeTVwOAo=",
      "endpoints": [
        "https://unkvoid.com/downloads/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
