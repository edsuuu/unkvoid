{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord 2.0",
  "version": "0.1.0",
  "identifier": "com.unkvoid.discord",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Discord 2.0",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "dmg", "app", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "SocialNetworking",
    "shortDescription": "Voz, vídeo e compartilhamento de tela",
    "longDescription": "Cliente desktop com captura de tela nativa, sem a barra do navegador e com áudio de sistema.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
