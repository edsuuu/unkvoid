{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "paths": {
            "hls.js/light": ["./node_modules/hls.js/dist/hls.d.mts"]
        }
    },
    "include": ["ui"]
}
