{
  "name": "unkvoid-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "run": "tauri dev --release",
    "dev:app": "tauri dev",
    "build:windows": "tauri build --bundles nsis,msi",
    "build:mac": "tauri build --bundles app,dmg",
    "build:linux": "tauri build --bundles deb,appimage",
    "check": "python3 tests/static/check-language.py && python3 tests/static/check-ui.py && tsc -p . && eslint ui tests && vitest run --project unit",
    "typecheck": "tsc -p .",
    "lint": "eslint ui tests",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "tauri": "tauri"
  },
  "dependencies": {
    "mediasoup-client": "^3.15.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^8",
    "vitest": "^5.0.0"
  }
}
