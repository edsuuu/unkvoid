# A instalação do `.deb` é a fonte das bibliotecas de execução; a imagem só oferece o APT e o
# Xvfb para manter o teste isolado do computador que construiu o pacote.
FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates xauth xvfb \
    && rm -rf /var/lib/apt/lists/*
