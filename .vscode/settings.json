{
  "rust-analyzer.linkedProjects": [
    "${workspaceFolder}/native/Cargo.toml"
  ],
  "rust-analyzer.check.command": "check",
  "rust-analyzer.check.extraArgs": [
    "--workspace"
  ],
  "files.watcherExclude": {
    "**/target/**": true,
    "**/node_modules/**": true,
    "**/web/storage/**": true
  }
}
