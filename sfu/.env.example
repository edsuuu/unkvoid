# Toda a configuração do SFU sai daqui, e nada aqui é segredo: a sala é anônima e o
# servidor não verifica assinatura nenhuma. São endereços, portas e limites.
#
# Em produção quem lê este arquivo é o ecosystem.config.cjs, e o que estiver aqui vence o
# que está lá dentro — é assim que a VPS ganha valores próprios sem editar um arquivo
# versionado. Local, exporte na mão: `SFU_PORT=3001 node dist/server.js`.
#
# Copie para `.env` e ajuste. O `.env` não vai para o repositório.

# Onde a sinalização escuta. Fica em 127.0.0.1 porque quem fala com o mundo é o nginx,
# e é dele que vem o X-Forwarded-For em que o teto por IP se apoia.
SFU_HOST=127.0.0.1
SFU_PORT=3000
SFU_PATH=/sfu

# O endereço que o servidor ANUNCIA para os clientes conectarem a mídia. Em produção é o
# IP público da máquina; errar isto é o clássico "entra na sala e não vê nada".
SFU_ANNOUNCED_ADDRESS=127.0.0.1

# Teto de conexões novas por IP por minuto. Com sala anônima, nada prova quem entra: o
# que impede varrer códigos é o custo de tentar. A verificação (`pnpm run check`) abre
# uma dúzia de sockets de uma vez e precisa deste número alto.
SFU_CONNECTIONS_PER_MINUTE=20

# Um worker do mediasoup é um processo de uma thread só: satura um core e para. Um por
# core, e cada um usa uma porta UDP a partir de SFU_MEDIA_PORT — 4 workers ocupam
# 40000-40003, e todas precisam estar abertas no firewall.
SFU_WORKERS=4
SFU_MEDIA_PORT=40000

# Ingest de RTP puro: é por aqui que o app desktop transmite, sem ICE e sem DTLS. Uma
# porta por worker, contando de SFU_PLAIN_PORT — 4 workers ocupam 41000-41003. Vídeo e
# áudio da mesma transmissão dividem a porta, então isto é uma transmissão por worker.
SFU_PLAIN_PORT=41000
SFU_PLAIN_PORTS=1

# Só para a verificação: contra qual servidor o `pnpm run check` roda.
SFU_CHECK_URL=ws://127.0.0.1:3000/sfu
