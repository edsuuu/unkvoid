# Copie para `.env`. Em produção o ecosystem.config.cjs lê este arquivo, e o que está aqui vence.

# O mesmo SFU_SECRET do web/.env, com 32 caracteres ou mais. Sem ele o SFU não sobe.
SFU_SECRET=

SFU_HOST=127.0.0.1
SFU_PORT=3000
SFU_PATH=/sfu
SFU_APP_VERSION=0.0.2

# O IP que os clientes usam para a mídia. Na VPS é o IP público: errado, entra na sala e não vê nada.
SFU_ANNOUNCED_ADDRESS=127.0.0.1

# Conexões novas por IP por minuto. O `pnpm run check` precisa de 200.
SFU_CONNECTIONS_PER_MINUTE=20

# Um worker por núcleo menos um; cada um usa uma porta UDP a partir de SFU_MEDIA_PORT.
SFU_WORKERS=7
SFU_MEDIA_PORT=40000

# RTP puro: SFU_PLAIN_PORTS portas por worker, a partir de SFU_PLAIN_PORT (docs/UDP.md).
SFU_PLAIN_PORT=41000
SFU_PLAIN_PORTS=64

# Para onde vai o aviso de quem entrou e saiu. Vazio desliga.
SFU_LARAVEL_URL=http://127.0.0.1:8000

# Contra qual servidor o `pnpm run check` roda.
SFU_CHECK_URL=ws://127.0.0.1:3000/sfu
