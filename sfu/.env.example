# Toda a configuração do SFU sai daqui. O único segredo é o SFU_SECRET.
#
# Em produção quem lê este arquivo é o ecosystem.config.cjs, e o que estiver aqui vence o
# que está lá dentro — é assim que a VPS ganha valores próprios sem editar um arquivo
# versionado. Local, exporte na mão: `SFU_PORT=3001 node dist/server.js`.
#
# Copie para `.env` e ajuste. O `.env` não vai para o repositório.

# O mesmo segredo do .env do Laravel. É com ele que o Laravel assina o token que o app
# apresenta no `join`, e o cabeçalho das chamadas que faz direto ao SFU (expulsar
# alguém). Sem ele o SFU não sobe. Mínimo de 32 caracteres.
SFU_SECRET=

# Onde a sinalização escuta. Fica em 127.0.0.1 porque quem fala com o mundo é o nginx,
# e é dele que vem o X-Forwarded-For em que o teto por IP se apoia.
SFU_HOST=127.0.0.1
SFU_PORT=3000
SFU_PATH=/sfu
SFU_APP_VERSION=0.0.2

# O endereço que o servidor ANUNCIA para os clientes conectarem a mídia. Em produção é o
# IP público da máquina, e é AQUI que ele mora — o ecosystem.config.cjs não o versiona,
# justamente para que trocar de VPS não deixe um IP morto no repositório. Errar isto é o
# clássico "entra na sala e não vê nada".
SFU_ANNOUNCED_ADDRESS=127.0.0.1

# Teto de conexões novas por IP por minuto. A verificação (`pnpm run check`) abre uma
# dúzia de sockets de uma vez e precisa deste número alto.
SFU_CONNECTIONS_PER_MINUTE=20

# Um worker do mediasoup é um processo de uma thread só: satura um core e para. Um por
# core MENOS UM, para o nginx, o php-fpm, o MySQL, o MinIO e o e-mail terem um núcleo
# inteiro: a VPS tem 8, então são 7. Cada worker usa uma porta UDP a partir de
# SFU_MEDIA_PORT — 7 workers ocupam 40000-40006, e todas precisam estar abertas no
# firewall.
SFU_WORKERS=7
SFU_MEDIA_PORT=40000

# RTP puro: é por aqui que o app desktop transmite e, no Linux, também recebe, sem ICE e
# sem DTLS. SFU_PLAIN_PORTS portas por worker, contando de SFU_PLAIN_PORT — 7 workers e
# 64 portas são 448 portas, ou seja 41000-41447, dentro da regra 41000-42000 do firewall.
# Vídeo e áudio do mesmo sentido dividem a porta; quem participa da voz pelo Linux gasta
# duas (envia e recebe).
SFU_PLAIN_PORT=41000
SFU_PLAIN_PORTS=64

# Para onde vai o aviso de quem entrou e saiu de um canal (`POST /api/sfu/events`,
# assinado como o token). Na VPS é o site (o ecosystem já aponta para ele); este é o
# valor local. Vazio, que é o padrão, desliga o aviso.
SFU_LARAVEL_URL=http://127.0.0.1:8000

# Clipes (só no modo servidor). O SFU guarda os últimos 5 minutos de cada tela
# compartilhada num canal — vídeo copiado, sem recomprimir — e o ffmpeg é quem grava e
# monta o clipe. Sem ele executável o SFU sobe igual, avisa uma vez no log e o pedido de
# clipe responde 503. No Ubuntu: `apt install ffmpeg`.
#
# Cada faixa gravada (tela, áudio da tela, mic) usa três portas UDP em 127.0.0.1 logo
# depois da faixa de RTP puro: nada disso precisa estar aberto no firewall.
SFU_FFMPEG=ffmpeg

# Onde fica o anel: precisa ser disco, não memória — cada transmissão segura uns 300 MB a
# 8 Mbit/s. Vazio usa a pasta temporária do sistema. A pasta é apagada a cada subida.
SFU_RECORDINGS_DIR=/var/tmp

# Só para a verificação: contra qual servidor o `pnpm run check` roda.
SFU_CHECK_URL=ws://127.0.0.1:3000/sfu
