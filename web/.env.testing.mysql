# A mesma suíte, no MySQL. Existe porque o SQLite perdoa o que o MySQL recusa:
# tipo de coluna, colação e chave estrangeira. Rode com `composer test:mysql`.
APP_NAME=Unkvoid
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unkvoid_test
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
BCRYPT_ROUNDS=4

DEBUGBAR_ENABLED=false

GOOGLE_CLIENT_ID=teste
GOOGLE_CLIENT_SECRET=teste
GOOGLE_REDIRECT_URI=http://localhost/oauth2/google/callback
UNKVOID_ADMIN_EMAIL=admin@unkvoid.test
SFU_URL=http://127.0.0.1:3000
SFU_PUBLIC_URL=ws://127.0.0.1:3000/sfu
SFU_SECRET=segredo-de-teste-com-mais-de-32-caracteres
RELEASE_SECRET=segredo-de-releases-de-teste-com-32-chars
AWS_ACCESS_KEY_ID=teste
AWS_SECRET_ACCESS_KEY=teste
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=teste
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
REVERB_APP_ID=teste
REVERB_APP_KEY=chave-de-teste
REVERB_APP_SECRET=segredo-de-teste
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
