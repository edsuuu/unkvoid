APP_NAME=Unkvoid
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unkvoid
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@unkvoid.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

DEBUGBAR_ENABLED=true

# A URL de retorno tem de estar cadastrada no console do Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth2/google/callback"

# Quem entra com este e-mail recebe o papel de administrador na primeira vez.
UNKVOID_ADMIN_EMAIL=

SFU_URL=http://127.0.0.1:3000
# O endereço do SFU que o app recebe pelo GET /api/config.
SFU_PUBLIC_URL=ws://127.0.0.1:3000/sfu
# O mesmo SFU_SECRET do sfu/.env, com 32 caracteres ou mais.
SFU_SECRET=

# Assina a publicação dos instaladores (publish-release.sh).
RELEASE_SECRET=

# MinIO: instaladores, fotos e imagens do chat.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=unkvoid
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

UNKVOID_APT_URL=https://unkvoid.com/apt

