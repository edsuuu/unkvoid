APP_NAME=Unkvoid
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Teste na rede local, com o app em outra máquina: APP_URL=http://<IP da LAN>:8000,
# SFU_PUBLIC_URL=ws://<IP da LAN>:3000/sfu e REVERB_HOST=<IP da LAN>.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unkvoid
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local: o Mailpit. Na VPS: o próprio servidor de e-mail, em mail.unkvoid.com:587.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@unkvoid.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

DEBUGBAR_ENABLED=true

# Login com Google. As duas URLs de retorno precisam estar cadastradas no console do
# Google, uma por ambiente: http://127.0.0.1:8000/oauth2/google/callback e
# https://unkvoid.com/oauth2/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth2/google/callback"

# Quem entra com este e-mail recebe o papel de administrador na primeira vez.
UNKVOID_ADMIN_EMAIL=

# O mesmo segredo do .env do SFU: é com ele que o token de entrada na sala é assinado
# aqui e conferido lá, e com ele que as chamadas diretas ao SFU (expulsar alguém) são
# assinadas. Mínimo de 32 caracteres. Sem ele ninguém entra em sala nenhuma.
SFU_URL=http://127.0.0.1:3000
# O endereço do SFU que o app usa, entregue pelo GET /api/config. Na VPS: wss://unkvoid.com/sfu.
SFU_PUBLIC_URL=ws://127.0.0.1:3000/sfu
SFU_SECRET=

# Com este segredo o CI publica instaladores pela API. Fica também nos secrets do GitHub.
RELEASE_SECRET=

# Onde os instaladores ficam: um bucket no MinIO, nunca no disco do servidor. As URLs de
# download saem assinadas e vencem. Na VPS o endpoint é https://s3.unkvoid.com.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=unkvoid
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

UNKVOID_APT_URL=https://unkvoid.com/apt

# Reverb: o servidor de tempo real (php artisan reverb:start). O app recebe host/porta/chave
# pelo GET /api/config. Na VPS: REVERB_SERVER_HOST=127.0.0.1 (só o nginx fala com ele),
# REVERB_HOST=unkvoid.com, REVERB_PORT=443, REVERB_SCHEME=https.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
